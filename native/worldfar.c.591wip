/*
 * worldfar.c -- the world map's spherical terrain and far field.
 * BUILD 585 (far field), 586 (CPU bend, tilt), 587 (this rewrite).
 *
 * Entry points (each reached through a small hook stub in ff7nx_worldfar):
 *
 *  worldfar_bend    after EVERY call of the port's terrain transform
 *                   0x10F28B0 -- the two inlined calls inside world_sub_751EFC
 *                   (the 5x5 window) and the one in the 0x75F0AD thunk.
 *                   BUILD 586 hooked only the thunk, which the window never
 *                   uses: the window stayed flat while models and the far
 *                   field were bent, which is the "square", the sky-coloured
 *                   strips at its edges and the characters sinking into the
 *                   ground when zoomed out. It bends the transformed vertices
 *                   exactly as FFNx's lmain_vv does, applies the same depth
 *                   squeeze as the models, and records the translation of
 *                   every native mesh so the far field knows which cells the
 *                   game really drew this frame.
 *  worldfar_draw    after world_sub_751EFC: everything the window does not
 *                   cover, out to the horizon, in three levels --
 *                     N  the game's own full-detail mesh, read on demand from
 *                        wm0.map into a cache, for the ring around the window
 *                        (and any window cell the game skipped), so the
 *                        ground at the window's edge is the same ground;
 *                     S  a 5x5-lattice copy of each mesh (wm0.far);
 *                     L2 a 9x9 copy of each 4x4-mesh sector (wm0.far).
 *                   The model->clip matrix of any tile is derived from four
 *                   calibration transforms per frame (it is affine in the GTE
 *                   translation), so no per-tile or per-triangle game call is
 *                   made except the shape allocation, which is batched.
 *  worldfar_camera  after the camera update 0x74E8CE: ZL/ZR zoom (FFNx up to
 *                   35000), right stick up/down tilt (FFNx 5..85 degrees).
 *  worldfar_input   around world_update_player 0x74EA48: right stick
 *                   left/right turns the camera; on foot the stock camera
 *                   spin from left/right is taken back out (FFNx analogue
 *                   behaviour: you walk where you point).
 *
 * All the far-field DATA lives in this module's BSS (State), not in the
 * guest heap: the world allocation only grows by a 32 KB file-read bounce
 * buffer. Compiled position-independent; HOST_TEST builds it against a fake
 * guest (native/worldfar_host_test.c).
 */
#include <stdint.h>
#ifdef HOST_TEST
static void host_tile(int level, int id, int px, int pz);
#define HOST_TILE(l, i, x, z) host_tile(l, i, x, z)
#else
#define HOST_TILE(l, i, x, z) ((void)0)
#endif

typedef uint8_t u8;
typedef int8_t s8;
typedef int16_t s16;
typedef uint16_t u16;
typedef int32_t s32;
typedef uint32_t u32;
typedef int64_t s64;
typedef uint64_t u64;

typedef u8 *(*g2h_fn)(u32 guest);
typedef u32 (*callx_fn)(u32 x86, u32 nargs, ...);

/* ---- guest globals (x86 VAs, ff7_en 1.02) ---- */
#define G_MAP_TYPE      0xE045E8u   /* 0 = overworld */
#define G_PLAYER_POS    0xE04918u   /* int x, y, z */
#define G_CAM_ROT       0xDFC448u   /* s16[9] */
#define G_CAM_DELTA_Y   0xDE6A04u
#define G_GTE           0x90AAF0u   /* -> state; translation int[3] at +0x22 */
#define G_WORLD_BASE    0xE2D600u   /* the world map's one allocation */
#define G_ONSET         0xE045D8u
#define G_MOVE_MULT     0xDFC480u   /* 1 or 2: logic steps per update */
#define G_CAM_FRONT     0xDFC484u   /* camera heading target, 0..4095 */
#define G_VIEW_TYPE     0xDFC4B4u   /* 3 = Highwind */
#define G_CONTROL       0xDE6B5Cu   /* player control enabled */

#define F_RESET_GTE     0x74D3A7u   /* SetRot(DFC448), SetTrans(DE6A20) */
#define F_APPLY         0x662ECCu   /* out = R*v + T (s16 v) */
#define F_NAME          0x74CA00u   /* (kind, idx) -> "...wm/WM<idx><ext>" */
#define F_READ          0x7593CDu   /* (name, offset, size, dest) -> 0 ok */
#define F_TRANSFORM     0x75F0ADu
#define F_ALLOC_SHAPES  0x66E272u   /* (n, graphics object) -> 0 if none */
#define F_DRAW_ENABLED  0x74C969u   /* the world's own per-triangle gate */

#define G_VERTS_F       0xE38338u   /* float x,y,z per vertex (0xC) */
#define G_COMBINED      0xE39738u   /* model -> clip, row vectors, 4x4 */
#define G_TEX_OBJS      0xE2BBD8u   /* graphics object per texture id */
#define G_TEX_ORIGIN    0xE2D168u   /* -> u16 u, v origin per texture id */
#define G_LIGHT         0xE360F4u   /* -> +0xF8 the 3x4 light matrix */
#define G_VIEW_X        0xE2C424u
#define G_VIEW_Y        0xE2C428u
#define G_VIEW_W        0xDE68F8u
#define G_VIEW_H        0xDE67E8u
#define G_CAM_TRANS     (0xDE6A20u + 0x12u)
#define G_CAM_TRANS_Z   (0xDE6A20u + 0x12u + 8u)
#define TL_STRIDE       0x20u       /* x,y,z,rhw,colour,specular,u,v */

/* ---- layout shared with ff7nx_worldfar.py (checked there) ---- */
#ifndef PRIM_BYTES
#define PRIM_BYTES      0x30000u
#endif
#define FAR_OFF         (0xA6800u + 2u * PRIM_BYTES)
#define FAR_NAME        0x000u      /* "...WM0.FAR" */
#define FAR_SCRATCH     0x100u      /* 0x40 for 0x662ECC */
#define FAR_IO          0x200u
#define FAR_IO_BYTES    0x8000u
#define FAR_REGION      (FAR_IO + FAR_IO_BYTES)
#ifndef FAR_MAX
#define FAR_MAX         0x3A0000u   /* wm0.far, held in BSS */
#endif

#define MX 36
#define MZ 28
#define SX 9
#define SZ 7
#define N1 (MX * MZ)
#define N2 (SX * SZ)
#define MESH 8192
#define WRAP_X 0x48000
#define WRAP_Z 0x38000
#define SECTOR_BYTES 0xB800

#define NEAR_RING       8           /* sectors holding ring <= 8 use S/N */
#define GRID            11          /* NEAR_RING + 3: a near sector's cells */
#define LOD_N           0.055f      /* a cell this wide on screen (of the
                                       viewport width) gets the game's own
                                       full-detail mesh; smaller, the S tile */
#define LOD_KEEP        0.04f       /* ... and keeps (or fetches) it until
                                       it is this small */
#define N_RESERVE       3000        /* triangles kept back for S/L2 */
#define NWANT           256
#define GW              (2 * GRID + 1)
#define NAT_MAX         64
#define HZ_AZ           81
#define HZ_SPAN         1.40        /* +-80 degrees about the heading */
#define SKY_PIECES      4
#define SKY_SLICES      12
#define NSLOT           224
#define SLOT_TRIS       256
#define SLOT_VERTS      128
#define LZ_BYTES        8192
#define LOADS_PER_FRAME 12
#define MAX_TRIS_FRAME  16000
#define MAX_TRIS_TILE   512

#define ZOOM_MAX_DIST   35000.0f    /* FFNx getMaxZoomDist */
#define ZOOM_STEP       125.0f      /* per logic step (x movement mult) */
#define STICK_DEADZONE  0.2f
#define TILT_STEP       0.01745f    /* 1 degree per logic step, FFNx */
#define YAW_STEP        11.4f       /* 1 degree (of 4096) per logic step */
#define TILT_MIN        0.0873f     /* 5 degrees below horizontal (FFNx -95) */
#define TILT_MAX        1.4835f     /* 85 degrees (FFNx -175) */
#define SPHERE_R        250000.0f
#define MOUNTAIN        4000.0f
#define BTN_ZL          (1ull << 8)
#define BTN_ZR          (1ull << 9)
#define BTN_R3          ((1ull << 5) | (1ull << 62))  /* 62: where the
                                       no-cheats cave moves StickR */

typedef struct {
    u32 tris, verts, norms;         /* offsets into data */
    u16 ntri;
    u16 sk_first[4];
    u8  sk_n[4];
    u8  nverts, flags;
    s16 ymin, ymax;
} Entry;                             /* == ENTRY_FMT, 32 bytes */

typedef struct {
    s16 cell;                        /* mz * MX + mx, -1 empty */
    u16 ntri, nv, pad;
    u32 used;                        /* frame last wanted */
    u8  tris[SLOT_TRIS * 12];
    s16 v[SLOT_VERTS * 4];
    s16 n[SLOT_VERTS * 4];
} Slot;

typedef struct {
    u32 obj;                         /* graphics object, 0 none */
    u8  perm[4];                     /* stock index of LT, LB, RT, RB */
    float yaw[4], elev[4];           /* per stock corner: world yaw, px above
                                        the flat horizon */
    u8  v[0x80];                     /* the stock quad (UV, colour, z, rhw) */
} SkyPiece;                          /* 168 */

typedef struct {
    u32 cloud_obj, cloud_ok, c_frame;
    float c_lo, c_hi, c_rate, c_phase, c_best;
    float c_etop, c_ebot;            /* px above the horizon */
    u8  c_perm[4];
    u8  c_v[0x80];
    u32 met_frame, n_met;
    SkyPiece met[SKY_PIECES];
} Sky;                               /* 12 + 20 + 8 + 4 + 128 + 8 + 4*168 */

typedef struct {
    u32 magic;                       /* 0x00 'WFAR' once loaded */
    u32 base;                        /* 0x04 world allocation it was loaded into */
    u32 failed_base;                 /* 0x08 do not retry a failed load there */
    u32 refs;                        /* 0x0C offset of the mesh refs in data */
    u32 frames;                      /* 0x10 */
    u32 last_tris;                   /* 0x14 diagnostics */
    u32 last_tiles;                  /* 0x18 */
    float zoom;                      /* 0x1C extra camera distance */
    float tilt;                      /* 0x20 camera pitch offset, radians */
    u32 busy;                        /* 0x24 calibrating: bend stays out */
    u32 nnat;                        /* 0x28 native meshes this frame */
    s32 front_saved;                 /* 0x2C camera front before the update */
    u32 saved_ok;                    /* 0x30 */
    u32 calib_bad;                   /* 0x34 frames the matrix check failed */
    u32 loads;                       /* 0x38 meshes read from wm0.map */
    u32 load_fail;                   /* 0x3C */
    u32 hz_frame;                    /* 0x40 frame the horizon tables are for */
    s32 zoom_added;                  /* 0x44 added to 0xDFC478 around the update */
    s32 hz_n;                        /* 0x48 samples in the horizon tables */
    s32 rot_saved;                   /* 0x4C 0xDFC474 before the player update */
    s32 facing;                      /* 0x50 the stick's facing this update */
    u32 facing_ok;                   /* 0x54 */
    s32 tilt_units;                  /* 0x58 read by the 0x74F916 cave */
    u64 got;                         /* 0x60 the input GOT slot */
    float hz_fwd;                    /* 0x68 camera yaw of the tables */
    s32 pitch_seen;                  /* 0x6C the game's own pitch, from the cave */
    float hz_yaw[HZ_AZ], hz_xc[HZ_AZ], hz_yc[HZ_AZ], hz_xf[HZ_AZ], hz_yf[HZ_AZ];
    Sky sky;
    s32 nat[NAT_MAX][3];
    Entry e[N1 + N2];
    u8 cls[N2];
    u8 pad_[1];
    u8 bad[N1];                      /* meshes wm0.map could not give */
    Slot slot[NSLOT];
    u8 lz[LZ_BYTES];
    u8 data[FAR_MAX];
} State;

_Static_assert(__builtin_offsetof(State, tilt_units) == 0x58, "tilt_units: the pitch cave reads +0x58");
_Static_assert(__builtin_offsetof(State, pitch_seen) == 0x6C, "pitch_seen: the pitch cave writes +0x6C");
_Static_assert(sizeof(SkyPiece) == 168, "SkyPiece size");
_Static_assert(sizeof(Sky) == 856, "Sky size (ff7nx_worldfar.SKY_BYTES)");

#define CLS_L2 0
#define CLS_NEAR 1

typedef struct {
    g2h_fn g2h;
    callx_fn call;
    State *st;
} Env;

/* ------------------------------------------------------------ memory */
static u32 ld32(const u8 *p) { return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24); }
static s16 ld16(const u8 *p) { return (s16)((u16)p[0] | ((u16)p[1] << 8)); }

/* The port translates guest addresses page by page (4 KB). */
static u8 rd8(Env *v, u32 g) { return *v->g2h(g); }
static u32 rd32(Env *v, u32 g)
{
    if ((g & 0xFFFu) <= 0xFFCu)
        return ld32(v->g2h(g));
    return (u32)rd8(v, g) | ((u32)rd8(v, g + 1) << 8)
         | ((u32)rd8(v, g + 2) << 16) | ((u32)rd8(v, g + 3) << 24);
}
static s16 rds16(Env *v, u32 g)
{
    return (s16)((u16)rd8(v, g) | ((u16)rd8(v, g + 1) << 8));
}
static void wr8(Env *v, u32 g, u8 x) { *v->g2h(g) = x; }
static void st32(u8 *p, u32 x) { p[0] = (u8)x; p[1] = (u8)(x >> 8); p[2] = (u8)(x >> 16); p[3] = (u8)(x >> 24); }
static void wr32(Env *v, u32 g, u32 x)
{
    if ((g & 0xFFFu) <= 0xFFCu) { st32(v->g2h(g), x); return; }
    wr8(v, g, (u8)x); wr8(v, g + 1, (u8)(x >> 8));
    wr8(v, g + 2, (u8)(x >> 16)); wr8(v, g + 3, (u8)(x >> 24));
}
static void wr16(Env *v, u32 g, u16 x) { wr8(v, g, (u8)x); wr8(v, g + 1, (u8)(x >> 8)); }

static void copy(u8 *d, const u8 *s, u32 n)
{
    for (u32 i = 0; i < n; i++) d[i] = s[i];
}
/* bulk guest <-> host, one translation per page */
static void gread(Env *v, u32 g, void *dst, u32 n)
{
    u8 *d = (u8 *)dst;
    while (n) {
        u32 room = 0x1000u - (g & 0xFFFu);
        u32 k = n < room ? n : room;
        copy(d, v->g2h(g), k);
        d += k; g += k; n -= k;
    }
}
static void gwrite(Env *v, u32 g, const void *src, u32 n)
{
    const u8 *s = (const u8 *)src;
    while (n) {
        u32 room = 0x1000u - (g & 0xFFFu);
        u32 k = n < room ? n : room;
        copy(v->g2h(g), s, k);
        s += k; g += k; n -= k;
    }
}

static float f_of(u32 b) { float f; __builtin_memcpy(&f, &b, 4); return f; }
static u32 b_of(float f) { u32 b; __builtin_memcpy(&b, &f, 4); return b; }
static float rdf(Env *v, u32 g) { return f_of(rd32(v, g)); }

static float fsqrt(float x)
{
#ifdef HOST_TEST
    return __builtin_sqrtf(x);
#else
    float r;
    __asm__("fsqrt %s0, %s1" : "=w"(r) : "w"(x));
    return r;
#endif
}
static float fabs_(float x) { return x < 0 ? -x : x; }
static double dabs(double x) { return x < 0 ? -x : x; }

static int wrapi(int d, int period)
{
    int h = period / 2;
    while (d >= h) d -= period;
    while (d < -h) d += period;
    return d;
}

/* ------------------------------------------------------------ series */
static void dsincos(double x, double *s, double *c)
{
    double x2 = x * x, t = x, ss = x, cc = 1.0, u = 1.0;
    for (int k = 1; k < 9; k++) {
        t *= -x2 / (double)((2 * k) * (2 * k + 1));
        ss += t;
        u *= -x2 / (double)((2 * k - 1) * (2 * k));
        cc += u;
    }
    *s = ss;
    *c = cc;
}
static double dexpm1(double x)
{
    if (x > 8.0) x = 8.0;
    if (x < -8.0) x = -8.0;
    int h = 0;
    while ((x > 0.25 || x < -0.25) && h < 8) { x *= 0.5; h++; }
    double t = x, r = x;
    for (int k = 2; k < 12; k++) { t *= x / (double)k; r += t; }
    while (h--) r = r * (r + 2.0);
    return r;
}

/* ------------------------------------------------------------ matrices */
typedef struct { double m[16]; } M4;

static void read_m4(Env *v, u32 g, M4 *o)
{
    u8 b[64];
    gread(v, g, b, 64);
    for (int i = 0; i < 16; i++) o->m[i] = f_of(ld32(b + 4 * i));
}

static int invert(const M4 *a, M4 *o)
{
    const double *m = a->m;
    double inv[16];
    inv[0] = m[5]*m[10]*m[15] - m[5]*m[11]*m[14] - m[9]*m[6]*m[15] + m[9]*m[7]*m[14] + m[13]*m[6]*m[11] - m[13]*m[7]*m[10];
    inv[4] = -m[4]*m[10]*m[15] + m[4]*m[11]*m[14] + m[8]*m[6]*m[15] - m[8]*m[7]*m[14] - m[12]*m[6]*m[11] + m[12]*m[7]*m[10];
    inv[8] = m[4]*m[9]*m[15] - m[4]*m[11]*m[13] - m[8]*m[5]*m[15] + m[8]*m[7]*m[13] + m[12]*m[5]*m[11] - m[12]*m[7]*m[9];
    inv[12] = -m[4]*m[9]*m[14] + m[4]*m[10]*m[13] + m[8]*m[5]*m[14] - m[8]*m[6]*m[13] - m[12]*m[5]*m[10] + m[12]*m[6]*m[9];
    inv[1] = -m[1]*m[10]*m[15] + m[1]*m[11]*m[14] + m[9]*m[2]*m[15] - m[9]*m[3]*m[14] - m[13]*m[2]*m[11] + m[13]*m[3]*m[10];
    inv[5] = m[0]*m[10]*m[15] - m[0]*m[11]*m[14] - m[8]*m[2]*m[15] + m[8]*m[3]*m[14] + m[12]*m[2]*m[11] - m[12]*m[3]*m[10];
    inv[9] = -m[0]*m[9]*m[15] + m[0]*m[11]*m[13] + m[8]*m[1]*m[15] - m[8]*m[3]*m[13] - m[12]*m[1]*m[11] + m[12]*m[3]*m[9];
    inv[13] = m[0]*m[9]*m[14] - m[0]*m[10]*m[13] - m[8]*m[1]*m[14] + m[8]*m[2]*m[13] + m[12]*m[1]*m[10] - m[12]*m[2]*m[9];
    inv[2] = m[1]*m[6]*m[15] - m[1]*m[7]*m[14] - m[5]*m[2]*m[15] + m[5]*m[3]*m[14] + m[13]*m[2]*m[7] - m[13]*m[3]*m[6];
    inv[6] = -m[0]*m[6]*m[15] + m[0]*m[7]*m[14] + m[4]*m[2]*m[15] - m[4]*m[3]*m[14] - m[12]*m[2]*m[7] + m[12]*m[3]*m[6];
    inv[10] = m[0]*m[5]*m[15] - m[0]*m[7]*m[13] - m[4]*m[1]*m[15] + m[4]*m[3]*m[13] + m[12]*m[1]*m[7] - m[12]*m[3]*m[5];
    inv[14] = -m[0]*m[5]*m[14] + m[0]*m[6]*m[13] + m[4]*m[1]*m[14] - m[4]*m[2]*m[13] - m[12]*m[1]*m[6] + m[12]*m[2]*m[5];
    inv[3] = -m[1]*m[6]*m[11] + m[1]*m[7]*m[10] + m[5]*m[2]*m[11] - m[5]*m[3]*m[10] - m[9]*m[2]*m[7] + m[9]*m[3]*m[6];
    inv[7] = m[0]*m[6]*m[11] - m[0]*m[7]*m[10] - m[4]*m[2]*m[11] + m[4]*m[3]*m[10] + m[8]*m[2]*m[7] - m[8]*m[3]*m[6];
    inv[11] = -m[0]*m[5]*m[11] + m[0]*m[7]*m[9] + m[4]*m[1]*m[11] - m[4]*m[3]*m[9] - m[8]*m[1]*m[7] + m[8]*m[3]*m[5];
    inv[15] = m[0]*m[5]*m[10] - m[0]*m[6]*m[9] - m[4]*m[1]*m[10] + m[4]*m[2]*m[9] + m[8]*m[1]*m[6] - m[8]*m[2]*m[5];
    double det = m[0]*inv[0] + m[1]*inv[4] + m[2]*inv[8] + m[3]*inv[12];
    if (dabs(det) < 1e-300) return 0;
    det = 1.0 / det;
    for (int i = 0; i < 16; i++) o->m[i] = inv[i] * det;
    return 1;
}

static void xform(const M4 *a, const double p[4], double o[4])
{
    for (int c = 0; c < 4; c++)
        o[c] = p[0] * a->m[c] + p[1] * a->m[4 + c] + p[2] * a->m[8 + c]
             + p[3] * a->m[12 + c];
}

/* ------------------------------------------------------------ the planet
 * BUILD 588. The world map is drawn on a planet that is fixed to the WORLD:
 * every point drops by d^2 / 2R, d being its horizontal distance from the
 * player (the focus the game draws the whole world map about), R = 250000.
 *
 * BUILD 584-587 used FFNx's ApplySphericalWorld, which bends in VIEW space
 * -- about the camera, along the camera's own up axis. The camera orbits the
 * player, so that "planet" turned and slid with every change of zoom, yaw or
 * tilt: terrain crept under the horizon and back as you rotated, models
 * moved against the ground, and with the Highwind's camera pitched past
 * vertical the curve even bent upward. A drop that depends only on world
 * position is rigid under any camera move, and it is one subtraction in
 * model space -- for the terrain here, and for every model, shadow, effect
 * and the Zolom through world_sub_762F9A (worldfar_sink), which is exactly
 * the vertical drop the game already applies to those.
 *
 * The horizon it gives is the sphere's: from height H it is sqrt(2 R H) away.
 */
static double drop_d(double x, double z)
{
    return (x * x + z * z) * (0.5 / (double)SPHERE_R);
}

/* clip.z = za * clip.w + zb for the perspective part of a combined matrix */
typedef struct { double za, zb, knee; int ok; } Zmap;

static void zmap_of(const M4 *a, Zmap *z)
{
    const double *m = a->m;
    double n3 = m[3] * m[3] + m[7] * m[7] + m[11] * m[11];
    z->ok = 0;
    z->knee = 1e30;
    if (n3 < 1e-20) return;
    z->za = (m[2] * m[3] + m[6] * m[7] + m[10] * m[11]) / n3;
    z->zb = m[14] - z->za * m[15];
    z->ok = 1;
    double den = 1.0 - z->za;
    if (den > 1e-12 || den < -1e-12) {
        double zf = z->zb / den;
        if (zf > 0.0) z->knee = 0.5 * zf;
    }
}

/* The depth squeeze lmain_vv applies to models: ndc = a + b / Z; past half
   the far plane Z is compressed smoothly into the rest of it. */
static double squeeze(double w, double a, double b)
{
    double den = 1.0 - a;
    if (den > -1e-12 && den < 1e-12) return w;
    double zf = b / den;
    if (!(zf > 0.0)) return w;
    double zc = 0.5 * zf, k = 0.999 * zf - zc;
    if (w <= zc) return w;
    return zc - k * dexpm1(-(w - zc) / k);
}

/* ------------------------------------------------------------ bend */
/* After the port's terrain transform: the transformed vertices are in the
   mesh's model space and the GTE holds the mesh's view translation, from
   which its offset from the player comes back through the camera rotation.
   Each vertex drops; one whose depth passes the squeeze knee also has its
   clip z squeezed (and is mapped back through the inverse matrix). */
__attribute__((section(".text.worldfar_bend")))
void worldfar_bend(State *st, g2h_fn g2h, callx_fn call)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    if (st->busy)
        return;                      /* the far field's own calibration */
    u32 gte = rd32(v, G_GTE);
    if (!gte)
        return;
    s32 t[3];
    for (int i = 0; i < 3; i++) t[i] = (s32)rd32(v, gte + 0x22 + 4 * i);
    if (st->nnat < NAT_MAX) {
        s32 *r = st->nat[st->nnat++];
        r[0] = t[0]; r[1] = t[1]; r[2] = t[2];
    }
    double R[3][3], d[3];
    for (int i = 0; i < 3; i++) {
        for (int j = 0; j < 3; j++)
            R[i][j] = (double)rds16(v, gte + 0x10 + 2 * (3 * i + j)) / 4096.0;
        d[i] = (double)t[i] - (double)(s32)rd32(v, G_CAM_TRANS + 4 * i);
    }
    double px = R[0][0] * d[0] + R[1][0] * d[1] + R[2][0] * d[2];
    double pz = R[0][2] * d[0] + R[1][2] * d[1] + R[2][2] * d[2];
    M4 m, inv;
    read_m4(v, G_COMBINED, &m);
    Zmap z;
    zmap_of(&m, &z);
    int have_inv = 0;
    u8 buf[122 * 12];
    gread(v, G_VERTS_F, buf, sizeof buf);
    for (u32 i = 0; i < 122; i++) {
        u8 *q = buf + 12 * i;
        double p[4] = { f_of(ld32(q)), f_of(ld32(q + 4)), f_of(ld32(q + 8)), 1.0 };
        p[1] -= drop_d(px + p[0], pz + p[2]);
        double c[4];
        xform(&m, p, c);
        if (z.ok && c[3] > z.knee) {
            if (!have_inv) have_inv = invert(&m, &inv) ? 1 : -1;
            if (have_inv > 0) {
                double r[4];
                c[2] = (z.za + z.zb / squeeze(c[3], z.za, z.zb)) * c[3];
                xform(&inv, c, r);
                if (dabs(r[3]) > 1e-12) {
                    p[0] = r[0] / r[3]; p[1] = r[1] / r[3]; p[2] = r[2] / r[3];
                }
            }
        }
        st32(q, b_of((float)p[0]));
        st32(q + 4, b_of((float)p[1]));
        st32(q + 8, b_of((float)p[2]));
    }
    gwrite(v, G_VERTS_F, buf, sizeof buf);
}

/* ------------------------------------------------------------ sink
 * world_sub_762F9A(dx, dz) -> how far a model, its shadow, an effect or the
 * Zolom drops below its true height (dx, dz from the player). The stock
 * routine is the old screen-space sink; all three of its callers land here
 * instead, so everything drops exactly as the terrain under it does. Called
 * in the recompiler's convention: args on the guest stack, eax out, the
 * callee pops the return address. */
__attribute__((section(".text.worldfar_sink")))
void worldfar_sink(State *st, g2h_fn g2h, callx_fn call, u8 *ctx)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    u32 esp = ld32(ctx + 0x10);
    s32 x = (s32)rd32(v, esp + 4), z = (s32)rd32(v, esp + 8);
    double dd = drop_d((double)x, (double)z);
    if (dd > 1e6) dd = 1e6;
    st32(ctx, (u32)(s32)(dd + 0.5));
    st32(ctx + 0x10, esp + 4);
}

/* ------------------------------------------------------------ loading */
static int name_copy(Env *v, u32 from, u32 to, int far_ext)
{
    u32 i = 0, dot = 0;
    for (; i < 120; i++) {
        u8 c = rd8(v, from + i);
        wr8(v, to + i, c);
        if (c == '.') dot = i;
        if (!c) break;
    }
    if (i >= 120 || !dot)
        return 0;
    if (far_ext) {
        wr8(v, to + dot + 1, 'F'); wr8(v, to + dot + 2, 'A');
        wr8(v, to + dot + 3, 'R'); wr8(v, to + dot + 4, 0);
    }
    return 1;
}

static int load(Env *v, u32 base)
{
    State *st = v->st;
    u32 far = base + FAR_OFF;
    u32 io = far + FAR_IO;
    u32 name = v->call(F_NAME, 2, 0, 0);
    if (!name)
        return 0;
    if (!name_copy(v, name, far + FAR_NAME, 1))
        return 0;
    if (v->call(F_READ, 4, far + FAR_NAME, 0, 32, io) != 0)
        return 0;
    u8 h[32];
    gread(v, io, h, 32);
    if (ld32(h) != 0x52414657u /* 'WFAR' */ || ld32(h + 4) != 3
        || ld32(h + 8) != N1 || ld32(h + 12) != N2 || ld32(h + 24) != 32)
        return 0;
    u32 total = ld32(h + 20), refs = ld32(h + 28);
    if (total < 32u + 32u * (N1 + N2) || total > FAR_MAX
        || refs > total || total - refs < 8u * N1)
        return 0;
    for (u32 at = 0; at < total; at += FAR_IO_BYTES) {
        u32 n = total - at < FAR_IO_BYTES ? total - at : FAR_IO_BYTES;
        if (v->call(F_READ, 4, far + FAR_NAME, at, n, io) != 0)
            return 0;
        gread(v, io, st->data + at, n);
    }
    if (ld32(st->data) != 0x52414657u)
        return 0;
    const u8 *p = st->data + 32;
    for (u32 k = 0; k < N1 + N2; k++, p += 32) {
        Entry *e = &st->e[k];
        e->tris = ld32(p);
        e->verts = ld32(p + 4);
        e->norms = ld32(p + 8);
        e->ntri = (u16)ld16(p + 12);
        u32 ntot = e->ntri;
        for (int j = 0; j < 4; j++) e->sk_first[j] = (u16)ld16(p + 14 + 2 * j);
        for (int j = 0; j < 4; j++) { e->sk_n[j] = p[22 + j]; ntot += e->sk_n[j]; }
        e->nverts = p[26];
        e->flags = p[27];
        e->ymin = ld16(p + 28);
        e->ymax = ld16(p + 30);
        if (e->nverts > 120 || ntot > MAX_TRIS_TILE
            || e->tris > total || (total - e->tris) / 12u < ntot
            || e->verts > total || (total - e->verts) / 6u < e->nverts
            || e->norms > total || (total - e->norms) / 3u < e->nverts)
            return 0;
        for (int j = 0; j < 4; j++)
            if ((u32)e->sk_first[j] + e->sk_n[j] > ntot)
                return 0;
    }
    for (u32 k = 0; k < N1; k++) {
        const u8 *r = st->data + refs + 8u * k;
        u32 off = ld32(r), len = ld32(r + 4);
        if (off > total || total - off < len || len > LZ_BYTES)
            return 0;
    }
    st->refs = refs;
    for (int s = 0; s < NSLOT; s++) { st->slot[s].cell = -1; st->slot[s].used = 0; st->slot[s].pad = 0; }
    for (int k = 0; k < N1; k++) st->bad[k] = 0;
    return 1;
}

/* FF7's LZSS (lgp.lzs_decompress): out is at most `cap` bytes */
static u32 lzs(const u8 *in, u32 n, u8 *out, u32 cap)
{
    u32 i = 0, o = 0;
    while (i < n) {
        u8 ctrl = in[i++];
        for (int bit = 0; bit < 8 && i < n; bit++) {
            if (ctrl & (1u << bit)) {
                if (o >= cap) return o;
                out[o++] = in[i++];
            } else {
                if (i + 1 >= n) return o;
                u32 b1 = in[i], b2 = in[i + 1];
                i += 2;
                u32 off = b1 | ((b2 & 0xF0u) << 4);
                u32 len = (b2 & 0x0Fu) + 3;
                u32 d = (o - 18 - off) & 0xFFFu;
                for (u32 k = 0; k < len; k++) {
                    if (o >= cap) return o;
                    s32 p = (s32)(o - d);
                    out[o] = (d == 0 || p < 0) ? 0 : out[p];
                    o++;
                }
            }
        }
    }
    return o;
}

/* one full-detail mesh: the game's own LZS block from wm0.map, carried in
   wm0.far (BSS), decoded into a cache slot. No file access after load. */
static int load_mesh(State *st, int cell, Slot *sl)
{
    const u8 *r = st->data + st->refs + 8u * (u32)cell;
    u32 off = ld32(r), len = ld32(r + 4);
    sl->cell = -1;
    if (!len || len > LZ_BYTES)
        return 0;
    u32 n = lzs(st->data + off, len, st->lz, LZ_BYTES);
    if (n < 4) return 0;
    u32 nt = (u16)ld16(st->lz), nv = (u16)ld16(st->lz + 2);
    if (nt > SLOT_TRIS || nv > 120 || 4 + nt * 12 + nv * 16 > n)
        return 0;
    const u8 *p = st->lz + 4;
    copy(sl->tris, p, nt * 12);
    p += nt * 12;
    for (u32 i = 0; i < nv * 4; i++) sl->v[i] = ld16(p + 2 * i);
    p += nv * 8;
    for (u32 i = 0; i < nv * 4; i++) sl->n[i] = ld16(p + 2 * i);
    for (u32 i = 0; i < nt; i++)
        if (sl->tris[12 * i] >= nv || sl->tris[12 * i + 1] >= nv
            || sl->tris[12 * i + 2] >= nv)
            return 0;
    sl->ntri = (u16)nt;
    sl->nv = (u16)nv;
    sl->cell = (s16)cell;
    sl->pad = 0;
    return 1;
}

static Slot *find_slot(State *st, int cell)
{
    for (int s = 0; s < NSLOT; s++)
        if (st->slot[s].cell == cell) return &st->slot[s];
    return 0;
}

static Slot *victim(State *st)
{
    Slot *best = 0;
    for (int s = 0; s < NSLOT; s++) {
        Slot *sl = &st->slot[s];
        if (sl->cell < 0) return sl;
        if (sl->used == st->frames) continue;
        if (!best || sl->used < best->used) best = sl;
    }
    return best;
}

/* ------------------------------------------------------------ camera */
typedef struct {
    float cx[3], cy[3], cz[3];       /* columns of R, unit scale */
    s32 t[3];
    float dy;                        /* -[DE6A04], the y of every tile pos */
    float horizon;                   /* draw radius about the focus */
} Cam;

static void apply(Env *v, u32 scratch, s16 x, s16 y, s16 z, s32 out[3])
{
    wr16(v, scratch, (u16)x); wr16(v, scratch + 2, (u16)y);
    wr16(v, scratch + 4, (u16)z); wr16(v, scratch + 6, 0);
    v->call(F_APPLY, 3, scratch, scratch + 0x10, scratch + 0x20);
    out[0] = (s32)rd32(v, scratch + 0x10);
    out[1] = (s32)rd32(v, scratch + 0x14);
    out[2] = (s32)rd32(v, scratch + 0x18);
}

static void camera(Env *v, u32 scratch, Cam *c)
{
    s32 o[3], a[3];
    v->call(F_RESET_GTE, 0);
    apply(v, scratch, 0, 0, 0, o);
    c->t[0] = o[0]; c->t[1] = o[1]; c->t[2] = o[2];
    apply(v, scratch, 4096, 0, 0, a);
    for (int i = 0; i < 3; i++) c->cx[i] = (float)(a[i] - o[i]) / 4096.0f;
    apply(v, scratch, 0, 4096, 0, a);
    for (int i = 0; i < 3; i++) c->cy[i] = (float)(a[i] - o[i]) / 4096.0f;
    apply(v, scratch, 0, 0, 4096, a);
    for (int i = 0; i < 3; i++) c->cz[i] = (float)(a[i] - o[i]) / 4096.0f;
    c->dy = -(float)(s32)rd32(v, G_CAM_DELTA_Y);
    float tx = (float)o[0], ty = (float)o[1], tz = (float)o[2];
    float camy = -(c->cy[0] * tx + c->cy[1] * ty + c->cy[2] * tz);
    float h = camy - c->dy;
    if (h < 0) h = -h;
    if (h < 500.0f) h = 500.0f;
    float d = fsqrt(2.0f * SPHERE_R * h) + fsqrt(2.0f * SPHERE_R * MOUNTAIN)
              + 16384.0f;
    if (d > 200000.0f) d = 200000.0f;
    c->horizon = d;
}

static void view(const Cam *c, float x, float y, float z, float out[3])
{
    for (int i = 0; i < 3; i++)
        out[i] = (float)c->t[i] + c->cx[i] * x + c->cy[i] * y + c->cz[i] * z;
}

/* ------------------------------------------------------------ drawing */
typedef struct {
    Env *v;
    Cam *c;
    u32 gte;
    int budget;
    int tiles;
    float light[12];                 /* the world's 3x4 light matrix */
    float vx0, vy0, vx1, vy1;        /* viewport in TL pixels (with margin) */
    float vw;                        /* viewport width in TL pixels */
    u32 origin_tab;                  /* guest -> u16 u,v origin per tex */
    float uvscale;                   /* Cosmos Gaia's terrain UV factor */
    double m0[16];                   /* combined matrix at translation 0 */
    double dm[3][4];                 /* d(row 3) / d(translation) */
} Ctx;

typedef struct {
    const u8 *tris;                  /* 12 bytes each */
    int ranges[5][2], nr;
    const u8 *v; u32 vstride;        /* s16 x,y,z at +0 */
    const u8 *n; u32 nstride;        /* normal x,y,z: s8 (/127) or s16 (/4096) */
    int n8;
    u32 nv;
} Mesh;

/* ---------------------------------------------------------- horizon (590)
 * The sea-level horizon of the planet, found analytically. The ground is
 * y = -r^2 / 2R about the player; from the eye (horizontal offset E, height
 * h above that ground) a line of sight along any ground direction u touches
 * it at distance s = sqrt(|E|^2 + 2 R h) -- the same in every direction.
 * For HZ_AZ directions across the view the tables hold that point on screen
 * (curved) and the direction at the eye's height, far away (flat), keyed by
 * world yaw. The sky is placed on the curved line from them. */
static double dsq(double x)
{
    if (!(x > 0.0)) return 0.0;
    double r = (double)fsqrt((float)x);
    if (!(r > 0.0)) r = 1.0;
    for (int i = 0; i < 3; i++) r = 0.5 * (r + x / r);
    return r;
}

static float fatan2(float y, float x);

static float wrap_pi(float a)
{
    const float P = 3.14159265f, T = 6.28318531f;
    for (int i = 0; i < 8 && a > P; i++) a -= T;
    for (int i = 0; i < 8 && a <= -P; i++) a += T;
    return a;
}

static void horizon(const Ctx *x, State *st)
{
    st->hz_frame = 0;
    st->hz_n = 0;
    double mf[16];
    tile_matrix(x, 0, 0, mf);
    const Cam *c = x->c;
    double t0 = c->t[0], t1 = c->t[1], t2 = c->t[2];
    double ex = -(c->cx[0] * t0 + c->cx[1] * t1 + c->cx[2] * t2);
    double ew = -(c->cy[0] * t0 + c->cy[1] * t1 + c->cy[2] * t2);
    double ez = -(c->cz[0] * t0 + c->cz[1] * t1 + c->cz[2] * t2);
    double ey = ew - (double)c->dy;
    if (!(ey > 50.0)) ey = 50.0;
    double fx = c->cx[2], fz = c->cz[2];
    double fl = dsq(fx * fx + fz * fz);
    if (fl < 1e-4) return;                   /* looking straight down */
    fx /= fl; fz /= fl;
    float fwd = fatan2((float)fx, (float)fz);
    const double R2 = 2.0 * (double)SPHERE_R;
    double s = dsq(ex * ex + ez * ez + R2 * ey);
    int n = 0;
    for (int i = 0; i < HZ_AZ; i++) {
        double th = -HZ_SPAN + 2.0 * HZ_SPAN * (double)i / (double)(HZ_AZ - 1);
        double sa, ca;
        dsincos(th, &sa, &ca);
        double ux = fx * ca + fz * sa, uz = fz * ca - fx * sa;
        double px = ex + s * ux, pz = ez + s * uz;
        double h = -(px * px + pz * pz) / R2;
        float xc, yc, xf, yf;
        if (!proj(mf, px, h, pz, &xc, &yc)) continue;
        if (!proj(mf, ex + 1.0e6 * ux, ey, ez + 1.0e6 * uz, &xf, &yf)) continue;
        if (!(xc > -1e6f && xc < 1e6f && yc > -1e6f && yc < 1e6f
              && xf > -1e6f && xf < 1e6f && yf > -1e6f && yf < 1e6f)) continue;
        st->hz_yaw[n] = fwd + (float)th;
        st->hz_xc[n] = xc; st->hz_yc[n] = yc;
        st->hz_xf[n] = xf; st->hz_yf[n] = yf;
        n++;
    }
    if (n < 2) return;
    st->hz_fwd = fwd;
    st->hz_n = n;
    st->hz_frame = st->frames;
}

/* vs at q, over keys ks that run one way (either); clamped at the ends */
static float lin(const float *ks, const float *vs, int n, float q)
{
    int inc = ks[n - 1] >= ks[0];
    if (inc ? q <= ks[0] : q >= ks[0]) return vs[0];
    if (inc ? q >= ks[n - 1] : q <= ks[n - 1]) return vs[n - 1];
    for (int i = 1; i < n; i++)
        if (inc ? q <= ks[i] : q >= ks[i]) {
            float span = ks[i] - ks[i - 1];
            float f = (span > 1e-9f || span < -1e-9f) ? (q - ks[i - 1]) / span : 0.0f;
            return vs[i - 1] + f * (vs[i] - vs[i - 1]);
        }
    return vs[n - 1];
}

/* a captured yaw brought next to this frame's heading, or 0 if it is
   outside the tables (not in view) */
static int yaw_here(const State *st, float yaw, float *out)
{
    float rel = wrap_pi(yaw - st->hz_fwd);
    if (rel < -(float)HZ_SPAN || rel > (float)HZ_SPAN) return 0;
    *out = st->hz_fwd + rel;
    return 1;
}

static void lerp_v(const u8 *a, const u8 *b, float t, u8 *o)
{
    for (int k = 0; k < 8; k++) {
        if (k == 4) {                                /* colour, per byte */
            for (int c = 0; c < 4; c++)
                o[16 + c] = (u8)((float)a[16 + c] + t * ((float)b[16 + c] - (float)a[16 + c]) + 0.5f);
        } else if (k == 5) {
            copy(o + 20, a + 20, 4);                 /* specular as given */
        } else {
            float fa = f_of(ld32(a + 4 * k)), fb = f_of(ld32(b + 4 * k));
            st32(o + 4 * k, b_of(fa + t * (fb - fa)));
        }
    }
}

/* the stock quad's corners as left-top, left-bottom, right-top,
   right-bottom (perm[k] = the stock index of that corner) */
static void corners(const u8 *q, u8 perm[4])
{
    int idx[4] = { 0, 1, 2, 3 };
    for (int a = 1; a < 4; a++) {                    /* by x */
        int k = idx[a], j = a;
        float xk = f_of(ld32(q + 0x20 * k));
        while (j > 0 && f_of(ld32(q + 0x20 * idx[j - 1])) > xk) { idx[j] = idx[j - 1]; j--; }
        idx[j] = k;
    }
    for (int s = 0; s < 4; s += 2) {                 /* top first in each pair */
        float ya = f_of(ld32(q + 0x20 * idx[s] + 4)), yb = f_of(ld32(q + 0x20 * idx[s + 1] + 4));
        if (yb < ya) { int t = idx[s]; idx[s] = idx[s + 1]; idx[s + 1] = t; }
    }
    perm[0] = (u8)idx[0]; perm[1] = (u8)idx[1];
    perm[2] = (u8)idx[2]; perm[3] = (u8)idx[3];
}

/* write one quad shape: roles LT, LB, RT, RB into their stock slots */
static int put_quad(Env *v, u32 dst, const u8 perm[4], const u8 *lt,
                    const u8 *lb, const u8 *rt, const u8 *rb)
{
    u8 o[0x80];
    copy(o + 0x20 * perm[0], lt, 0x20);
    copy(o + 0x20 * perm[1], lb, 0x20);
    copy(o + 0x20 * perm[2], rt, 0x20);
    copy(o + 0x20 * perm[3], rb, 0x20);
    gwrite(v, dst, o, 0x80);
    return 1;
}

/* n quad shapes on obj: the vertex pointer, or 0 */
static u32 sky_alloc(Env *v, u32 obj, u32 n)
{
    if (!obj || !n || !v->call(F_ALLOC_SHAPES, 2, n, obj)) return 0;
    u32 vp = rd32(v, obj + 0x70), stride = rd32(v, obj + 0x40);
    if (!vp || stride != 0x80u) return 0;
    return vp;
}

static void set_xy(u8 *o, float xs, float ys)
{
    st32(o, b_of(xs));
    st32(o + 4, b_of(ys));
}

/* BUILD 590: the sky is drawn here, every frame, from what the stock sky
   last showed -- not by moving the stock quads. The stock sky sits on the
   FLAT horizon and is skipped whenever that line is off screen (high up,
   looking down), so the clouds vanished exactly when the curved horizon
   was most visible; and cutting the stock quads up in place bent them with
   a noisy table and whatever pitch the stock sky used. Now:
     clouds  a band around the whole view: its bottom on the curved horizon
             at every column, its height and texture scroll (u per radian
             of yaw, snapped so a full turn is whole tiles) taken from the
             stock band;
     meteor  its pieces fixed at the world yaw they were last seen at, each
             corner the same height above the curved horizon as it stood
             above the flat one, cut into SKY_SLICES columns. */
static void sky_draw(Ctx *x, State *st)
{
    Env *v = x->v;
    Sky *k = &st->sky;
    int n = st->hz_n;
    if (!st->hz_frame || n < 2) return;
    const float *yw = st->hz_yaw;
    if (k->cloud_ok && k->cloud_obj && k->c_hi > k->c_lo) {
        float span = k->c_hi - k->c_lo;
        float x0 = x->vx0 + 0.20f * x->vw, x1 = x->vx1 - 0.20f * x->vw;
        const int NC = 24;
        float ya[NC + 1];
        for (int i = 0; i <= NC; i++)
            ya[i] = lin(st->hz_xc, yw, n, x0 + (x1 - x0) * (float)i / (float)NC);
        u8 top[0x20], bot[0x20];
        copy(top, k->c_v + 0x20 * k->c_perm[0], 0x20);
        copy(bot, k->c_v + 0x20 * k->c_perm[1], 0x20);
        for (int i = 0; i < NC; i++) {
            float a = ya[i], b = ya[i + 1];
            if (!(a != b)) continue;
            float ua = k->c_phase + k->c_rate * a, ub = k->c_phase + k->c_rate * b;
            /* split where the unwrapped u crosses a tile edge */
            float cuts[4];
            int nc = 0;
            cuts[nc++] = 0.0f;
            float lo = ua < ub ? ua : ub, hi = ua < ub ? ub : ua;
            float edge = k->c_lo + span * (float)(s32)((lo - k->c_lo) / span + (lo >= k->c_lo ? 1.0f : 0.0f));
            while (edge < hi && nc < 3) {
                cuts[nc++] = (edge - ua) / (ub - ua);
                edge += span;
            }
            cuts[nc++] = 1.0f;
            for (int s = 0; s + 1 < nc; s++) {
                float t0 = cuts[s], t1 = cuts[s + 1];
                if (!(t1 > t0)) continue;
                float y0 = a + (b - a) * t0, y1 = a + (b - a) * t1;
                float um = k->c_phase + k->c_rate * 0.5f * (y0 + y1);
                float base = k->c_lo + span * (float)(s32)((um - k->c_lo) / span - (um < k->c_lo ? 1.0f : 0.0f));
                float u0 = k->c_phase + k->c_rate * y0 - base;
                float u1 = k->c_phase + k->c_rate * y1 - base;
                u32 dst = sky_alloc(v, k->cloud_obj, 1);
                if (!dst) return;
                u8 lt[0x20], lb[0x20], rt[0x20], rb[0x20];
                copy(lt, top, 0x20); copy(rt, top, 0x20);
                copy(lb, bot, 0x20); copy(rb, bot, 0x20);
                float xa = lin(yw, st->hz_xc, n, y0), yha = lin(yw, st->hz_yc, n, y0);
                float xb = lin(yw, st->hz_xc, n, y1), yhb = lin(yw, st->hz_yc, n, y1);
                set_xy(lt, xa, yha - k->c_etop); set_xy(lb, xa, yha - k->c_ebot);
                set_xy(rt, xb, yhb - k->c_etop); set_xy(rb, xb, yhb - k->c_ebot);
                st32(lt + 0x18, b_of(u0)); st32(lb + 0x18, b_of(u0));
                st32(rt + 0x18, b_of(u1)); st32(rb + 0x18, b_of(u1));
                /* keep the column's left/right as the stock quad had them */
                if (xa <= xb) put_quad(v, dst, k->c_perm, lt, lb, rt, rb);
                else put_quad(v, dst, k->c_perm, rt, rb, lt, lb);
            }
        }
    }
    for (u32 p = 0; p < k->n_met && p < SKY_PIECES; p++) {
        SkyPiece *pc = &k->met[p];
        if (!pc->obj) continue;
        float yl_t, yl_b, yr_t, yr_b;
        if (!yaw_here(st, pc->yaw[pc->perm[0]], &yl_t) || !yaw_here(st, pc->yaw[pc->perm[1]], &yl_b)
            || !yaw_here(st, pc->yaw[pc->perm[2]], &yr_t) || !yaw_here(st, pc->yaw[pc->perm[3]], &yr_b))
            continue;
        u32 dst = sky_alloc(v, pc->obj, SKY_SLICES);
        if (!dst) return;
        const u8 *LT = pc->v + 0x20 * pc->perm[0], *LB = pc->v + 0x20 * pc->perm[1];
        const u8 *RT = pc->v + 0x20 * pc->perm[2], *RB = pc->v + 0x20 * pc->perm[3];
        float et[2] = { pc->elev[pc->perm[0]], pc->elev[pc->perm[2]] };
        float eb[2] = { pc->elev[pc->perm[1]], pc->elev[pc->perm[3]] };
        for (int s = 0; s < SKY_SLICES; s++) {
            float t0 = (float)s / (float)SKY_SLICES, t1 = (float)(s + 1) / (float)SKY_SLICES;
            u8 lt[0x20], lb[0x20], rt[0x20], rb[0x20];
            lerp_v(LT, RT, t0, lt); lerp_v(LB, RB, t0, lb);
            lerp_v(LT, RT, t1, rt); lerp_v(LB, RB, t1, rb);
            float ts[2] = { t0, t1 };
            u8 *tv[2] = { lt, rt }, *bv[2] = { lb, rb };
            for (int e = 0; e < 2; e++) {
                float t = ts[e];
                float yt = yl_t + (yr_t - yl_t) * t, yb = yl_b + (yr_b - yl_b) * t;
                float vt = et[0] + (et[1] - et[0]) * t, vb = eb[0] + (eb[1] - eb[0]) * t;
                set_xy(tv[e], lin(yw, st->hz_xc, n, yt), lin(yw, st->hz_yc, n, yt) - vt);
                set_xy(bv[e], lin(yw, st->hz_xc, n, yb), lin(yw, st->hz_yc, n, yb) - vb);
            }
            put_quad(v, dst + 0x80u * (u32)s, pc->perm, lt, lb, rt, rb);
        }
    }
}

/* After each stock sky quad of 0x754493 (clouds, meteor): learn it, then
   empty it -- sky_draw draws the sky from what is learnt here. Runs after
   the far field in the same frame, so this frame's tables apply. */
__attribute__((section(".text.worldfar_sky")))
void worldfar_sky(State *st, g2h_fn g2h, callx_fn call, u8 *ctx)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    if (rd32(v, G_MAP_TYPE) != 0 || !st->hz_frame || st->hz_frame != st->frames
        || st->hz_n < 2)
        return;
    u32 esp = ld32(ctx + 0x10);
    u32 desc = rd32(v, esp);
    if (!desc) return;
    u32 obj = rd32(v, desc + 0x28);
    if (!obj) return;
    u32 vp = rd32(v, obj + 0x70);
    if (!vp || rd32(v, obj + 0x40) != 0x80u) return;
    u8 q[0x80];
    gread(v, vp, q, 0x80);
    if (f_of(ld32(q)) != (float)rds16(v, desc + 8)
        || f_of(ld32(q + 4)) != (float)rds16(v, desc + 0xA)
        || f_of(ld32(q + 0x60)) != (float)rds16(v, desc + 0x20)
        || f_of(ld32(q + 0x64)) != (float)rds16(v, desc + 0x22))
        return;                                      /* not drawn this call */
    u8 perm[4];
    corners(q, perm);
    int n = st->hz_n;
    float yaw[4], elev[4];
    for (int c = 0; c < 4; c++) {
        float xs = f_of(ld32(q + 0x20 * c)), ys = f_of(ld32(q + 0x20 * c + 4));
        yaw[c] = lin(st->hz_xf, st->hz_yaw, n, xs);
        elev[c] = lin(st->hz_yaw, st->hz_yf, n, yaw[c]) - ys;
    }
    float xl = f_of(ld32(q + 0x20 * perm[0])), xr = f_of(ld32(q + 0x20 * perm[2]));
    float yt = f_of(ld32(q + 0x20 * perm[0] + 4)), yb = f_of(ld32(q + 0x20 * perm[1] + 4));
    float w = xr - xl, h = yb - yt;
    Sky *k = &st->sky;
    if (h > 0.5f && w >= 2.5f * h) {
        /* a piece of the cloud band */
        float ul = f_of(ld32(q + 0x20 * perm[0] + 0x18)), ur = f_of(ld32(q + 0x20 * perm[2] + 0x18));
        float dy = yaw[perm[2]] - yaw[perm[0]];
        float lo = ul < ur ? ul : ur, hi = ul < ur ? ur : ul;
        if (k->c_frame != st->frames || k->cloud_obj != obj) {
            k->c_frame = st->frames;
            k->cloud_obj = obj;
            k->c_lo = lo; k->c_hi = hi;
            k->c_best = 0.0f;
        } else {
            if (lo < k->c_lo) k->c_lo = lo;
            if (hi > k->c_hi) k->c_hi = hi;
        }
        float ady = dy < 0 ? -dy : dy;
        if (ady > 0.02f && ady > k->c_best && k->c_hi > k->c_lo) {
            float rate = (ur - ul) / dy;
            /* whole tiles per turn: no seam anywhere around */
            float span = k->c_hi - k->c_lo;
            float tiles = rate * 6.28318531f / span;
            float rt = (float)(s32)(tiles + (tiles < 0 ? -0.5f : 0.5f));
            if (rt != 0.0f) rate = rt * span / 6.28318531f;
            k->c_best = ady;
            k->c_rate = rate;
            k->c_phase = ul - rate * wrap_pi(yaw[perm[0]] - st->hz_fwd) - rate * st->hz_fwd;
            k->c_etop = 0.5f * (elev[perm[0]] + elev[perm[2]]);
            k->c_ebot = 0.5f * (elev[perm[1]] + elev[perm[3]]);
            copy(k->c_perm, perm, 4);
            copy(k->c_v, q, 0x80);
            k->cloud_ok = 1;
        }
    } else if (h > 0.5f && w > 0.5f) {
        /* the meteor: this frame's pieces replace the last ones */
        if (k->met_frame != st->frames) { k->met_frame = st->frames; k->n_met = 0; }
        if (k->n_met < SKY_PIECES) {
            SkyPiece *pc = &k->met[k->n_met++];
            pc->obj = obj;
            for (int c = 0; c < 4; c++) { pc->yaw[c] = yaw[c]; pc->elev[c] = elev[c]; }
            copy(pc->perm, perm, 4);
            copy(pc->v, q, 0x80);
        }
    } else {
        return;
    }
    /* the stock copy draws nothing now (zero area) */
    for (int c = 1; c < 4; c++) copy(q + 0x20 * c, q, 8);
    gwrite(v, vp, q, 0x80);
}

/* How wide one cell at tile position (px, pz) looks on screen, as a
   fraction of the viewport: its four corners at mid height, on the planet,
   through the same matrix emit() uses. A corner behind the eye counts as
   huge (the cell is right under or beside the camera). */
static void tile_matrix(const Ctx *x, s32 px, s32 pz, double mf[16]);
static int proj(const double mf[16], double p0, double p1, double p2, float *sx, float *sy);
static float footprint(const Ctx *x, s32 px, s32 pz, float ymid)
{
    double mf[16];
    tile_matrix(x, px, pz, mf);
    const double k2 = 0.5 / (double)SPHERE_R;
    float x0 = 1e30f, x1 = -1e30f, y0 = 1e30f, y1 = -1e30f;
    for (int k = 0; k < 4; k++) {
        double cx = (k & 1) ? MESH : 0, cz = (k & 2) ? MESH : 0;
        double ax = px + cx, az = pz + cz;
        float sx, sy;
        if (!proj(mf, cx, ymid - (ax * ax + az * az) * k2, cz, &sx, &sy))
            return 1.0f;
        if (sx < x0) x0 = sx;
        if (sx > x1) x1 = sx;
        if (sy < y0) y0 = sy;
        if (sy > y1) y1 = sy;
    }
    float w = x1 - x0, h = y1 - y0;
    return (w > h ? w : h) / x->vw;
}

static int visible(Ctx *x, float px, float pz, float half, float ymin, float ymax)
{
    float ymid = 0.5f * (ymin + ymax);
    float r = half * 1.4143f + 0.5f * (ymax - ymin) + 64.0f;
    float w[3];
    view(x->c, px, x->c->dy + ymid, pz, w);
    if (w[2] + r < 0.0f)
        return 0;
    if (fabs_(w[0]) - r > 1.9f * (w[2] + r))
        return 0;
    return 1;
}

typedef struct { float x, y, z, rhw; u32 col; int ok; } TV;

/* 0x68DAE1 with the base colour 0x75F68C uses (255,255,255, alpha 0xFF) */
static u8 chan(float l)
{
    if (l < 0.0f) return 0;
    float s = 255.0f * l;
    if (s >= 255.0f) return 255;
    return (u8)__builtin_rintf(s);
}

static u32 light(const Ctx *x, float nx, float ny, float nz)
{
    const float *m = x->light;
    float lx = m[0] * nx + m[1] * ny + m[2] * nz + m[3];
    float ly = m[4] * nx + m[5] * ny + m[6] * nz + m[7];
    float lz = m[8] * nx + m[9] * ny + m[10] * nz + m[11];
    return (u32)chan(lz) | ((u32)chan(ly) << 8) | ((u32)chan(lx) << 16)
         | 0xFF000000u;
}

static void put_tl(Env *v, u32 q, const TV *p, float u, float w)
{
    u8 b[0x14];
    st32(b, b_of(p->x)); st32(b + 4, b_of(p->y)); st32(b + 8, b_of(p->z));
    st32(b + 12, b_of(p->rhw)); st32(b + 16, p->col);
    gwrite(v, q, b, 0x14);           /* +0x14 (specular) left as the engine has it */
    u8 t[8];
    st32(t, b_of(u)); st32(t + 4, b_of(w));
    gwrite(v, q + 0x18, t, 8);
}

static void emit(Ctx *x, const Mesh *me, s32 px, s32 pz)
{
    Env *v = x->v;
    State *st = v->st;
    if (me->nv == 0 || me->nv > SLOT_VERTS || x->budget <= 0)
        return;
    float w[3];
    view(x->c, (float)px, x->c->dy, (float)pz, w);
    double t[3] = { (double)(s32)w[0], (double)(s32)w[1], (double)(s32)w[2] };
    M4 m;
    for (int i = 0; i < 12; i++) m.m[i] = x->m0[i];
    for (int c = 0; c < 4; c++)
        m.m[12 + c] = x->m0[12 + c] + t[0] * x->dm[0][c] + t[1] * x->dm[1][c]
                    + t[2] * x->dm[2][c];
    Zmap z;
    zmap_of(&m, &z);
    if (!z.ok) return;
    const double *mf = m.m;
    const double k2 = 0.5 / (double)SPHERE_R;
    const double fpx = (double)px, fpz = (double)pz;

    TV tv[SLOT_VERTS];
    for (u32 i = 0; i < me->nv; i++) {
        const u8 *pv = me->v + me->vstride * i;
        double p0 = (double)ld16(pv), p1 = (double)ld16(pv + 2), p2 = (double)ld16(pv + 4);
        double ax = fpx + p0, az = fpz + p2;
        p1 -= (ax * ax + az * az) * k2;          /* the planet */
        double c0 = p0 * mf[0] + p1 * mf[4] + p2 * mf[8] + mf[12];
        double c1 = p0 * mf[1] + p1 * mf[5] + p2 * mf[9] + mf[13];
        double cw = p0 * mf[3] + p1 * mf[7] + p2 * mf[11] + mf[15];
        TV *o = &tv[i];
        o->ok = cw > 1.0;
        if (!o->ok) continue;
        double rhw = 1.0 / cw;
        o->x = (float)(c0 * rhw);
        o->y = (float)(c1 * rhw);
        o->rhw = (float)rhw;
        o->z = (float)(z.za + z.zb / squeeze((double)cw, z.za, z.zb));
        const u8 *pn = me->n + me->nstride * i;
        float nx, ny, nz;
        if (me->n8) {
            nx = (float)(s8)pn[0] * (1.0f / 127.0f);
            ny = (float)(s8)pn[1] * (1.0f / 127.0f);
            nz = (float)(s8)pn[2] * (1.0f / 127.0f);
        } else {
            nx = (float)ld16(pn) * (1.0f / 4096.0f);
            ny = (float)ld16(pn + 2) * (1.0f / 4096.0f);
            nz = (float)ld16(pn + 4) * (1.0f / 4096.0f);
        }
        o->col = light(x, nx, ny, nz);
    }

    /* accept, then group by texture so shapes are allocated in batches */
    u16 acc[MAX_TRIS_TILE], key[MAX_TRIS_TILE];
    int na = 0;
    for (int r = 0; r < me->nr; r++)
        for (int ti = me->ranges[r][0]; ti < me->ranges[r][0] + me->ranges[r][1]; ti++) {
            const u8 *tb = me->tris + 12 * ti;
            if (tb[0] >= me->nv || tb[1] >= me->nv || tb[2] >= me->nv) continue;
            const TV *p0 = &tv[tb[0]], *p1 = &tv[tb[1]], *p2 = &tv[tb[2]];
            if (!p0->ok || !p1->ok || !p2->ok) continue;
            /* 0x760CC4, and 0x75F68C keeps area >= 0 after fistp */
            float area = p0->x * p1->y + p1->x * p2->y + p2->x * p0->y
                       - p0->x * p2->y - p1->x * p0->y - p2->x * p1->y;
            if (__builtin_rintf(area) < 0.0f) continue;
            if ((p0->x < x->vx0 && p1->x < x->vx0 && p2->x < x->vx0)
                || (p0->x > x->vx1 && p1->x > x->vx1 && p2->x > x->vx1)
                || (p0->y < x->vy0 && p1->y < x->vy0 && p2->y < x->vy0)
                || (p0->y > x->vy1 && p1->y > x->vy1 && p2->y > x->vy1))
                continue;
            if (na >= MAX_TRIS_TILE || na >= x->budget) break;
            u16 tex = (u16)(((u32)tb[10] | ((u32)tb[11] << 8)) & 0x1FF);
            int j = na++;
            while (j > 0 && key[j - 1] > tex) { key[j] = key[j - 1]; acc[j] = acc[j - 1]; j--; }
            key[j] = tex;
            acc[j] = (u16)ti;
        }

    for (int i = 0; i < na;) {
        u32 tex = key[i];
        int end = i;
        while (end < na && key[end] == tex) end++;
        u32 obj = rd32(v, G_TEX_OBJS + 4 * tex);
        if (!obj) { i = end; continue; }
        float su = rdf(v, obj + 0x24) * x->uvscale, sv = rdf(v, obj + 0x28) * x->uvscale;
        u32 og = rd32(v, x->origin_tab + 4 * tex);
        s32 ou = (s32)(og & 0xFFFF), ov = (s32)(og >> 16);
        while (i < end) {
            u32 rem = rd32(v, obj + 0x50);
            u32 want = (u32)(end - i);
            u32 k = rem > 0 && rem < 0x10000u ? rem : 32u;
            if (k > want) k = want;
            if (!v->call(F_ALLOC_SHAPES, 2, k, obj)) { i = end; break; }
            u32 vp = rd32(v, obj + 0x70);
            u32 stride = rd32(v, obj + 0x40);
            if (!vp) { i = end; break; }
            if (stride < 0x60u) stride = 0x60u;
            for (u32 s = 0; s < k; s++, i++) {
                const u8 *tb = me->tris + 12 * acc[i];
                u32 q = vp + stride * s;
                for (int c = 0; c < 3; c++)
                    put_tl(v, q + TL_STRIDE * (u32)c, &tv[tb[c]],
                           (float)((s32)tb[4 + 2 * c] - ou) * su,
                           (float)((s32)tb[5 + 2 * c] - ov) * sv);
                x->budget--;
                st->last_tris++;
            }
        }
    }
    x->tiles++;
}

static void mesh_s(const State *st, const Entry *e, u8 skirts, Mesh *m)
{
    m->tris = st->data + e->tris;
    m->nr = 0;
    m->ranges[m->nr][0] = 0; m->ranges[m->nr][1] = e->ntri; m->nr++;
    for (int k = 0; k < 4; k++)
        if ((skirts & (1 << k)) && e->sk_n[k]) {
            m->ranges[m->nr][0] = e->sk_first[k];
            m->ranges[m->nr][1] = e->sk_n[k];
            m->nr++;
        }
    m->v = st->data + e->verts; m->vstride = 6;
    m->n = st->data + e->norms; m->nstride = 3; m->n8 = 1;
    m->nv = e->nverts;
}

static void mesh_n(const Slot *sl, Mesh *m)
{
    m->tris = sl->tris;
    m->nr = 1;
    m->ranges[0][0] = 0; m->ranges[0][1] = sl->ntri;
    m->v = (const u8 *)sl->v; m->vstride = 8;
    m->n = (const u8 *)sl->n; m->nstride = 8; m->n8 = 0;
    m->nv = sl->nv;
}

/* The combined matrix is world*view*projection with the GTE translation in
   the view: row 3 is affine in that translation and rows 0..2 do not depend
   on it. Four transforms give both; a fifth checks it. */
static int calibrate(Env *v, Ctx *x, u32 io, u32 onset)
{
    State *st = v->st;
    M4 m[5];
    s32 T4[3] = { 12345, -6789, 23456 };
    st->busy = 1;
    for (int k = 0; k < 5; k++) {
        for (int i = 0; i < 3; i++) {
            s32 t = k == 4 ? T4[i] : (k == i + 1 ? 32768 : 0);
            wr32(v, x->gte + 0x22 + 4 * i, (u32)t);
        }
        v->call(F_TRANSFORM, 2, io, onset);
        read_m4(v, G_COMBINED, &m[k]);
    }
    st->busy = 0;
    for (int i = 0; i < 16; i++) x->m0[i] = m[0].m[i];
    for (int a = 0; a < 3; a++)
        for (int c = 0; c < 4; c++)
            x->dm[a][c] = (m[1 + a].m[12 + c] - m[0].m[12 + c]) / 32768.0;
    for (int k = 1; k < 5; k++)
        for (int i = 0; i < 12; i++) {
            double d = m[k].m[i] - m[0].m[i];
            if (dabs(d) > 1e-4 * (dabs(m[0].m[i]) + 1.0)) return 0;
        }
    for (int c = 0; c < 4; c++) {
        double want = m[0].m[12 + c] + T4[0] * x->dm[0][c]
                    + T4[1] * x->dm[1][c] + T4[2] * x->dm[2][c];
        if (dabs(want - m[4].m[12 + c]) > 1e-3 * (dabs(want) + 100.0)) return 0;
    }
    return 1;
}

static int ringof(int dx, int dz)
{
    int a = dx < 0 ? -dx : dx, b = dz < 0 ? -dz : dz;
    return a > b ? a : b;
}

static void draw(Env *v, State *st, float uvscale)
{
    if (rd32(v, G_MAP_TYPE) != 0)
        return;
    u32 base = rd32(v, G_WORLD_BASE);
    if (!base)
        return;
    if (st->magic != 0x52414657u)
        return;                      /* worldfar_alloc loads it, once */
    st->frames++;
    st->last_tris = 0;
    st->last_tiles = 0;
    if (!v->call(F_DRAW_ENABLED, 0))
        return;

    s32 fx = (s32)rd32(v, G_PLAYER_POS);
    s32 fz = (s32)rd32(v, G_PLAYER_POS + 8);
    fx = ((fx % WRAP_X) + WRAP_X) % WRAP_X;
    fz = ((fz % WRAP_Z) + WRAP_Z) % WRAP_Z;
    int cx = fx >> 13, cz = fz >> 13;
    s32 lx = fx & 0x1FFF, lz = fz & 0x1FFF;

    Cam cam;
    u32 far = base + FAR_OFF;
    camera(v, far + FAR_SCRATCH, &cam);
    Ctx x;
    x.v = v; x.c = &cam; x.tiles = 0;
    x.gte = rd32(v, G_GTE);
    x.budget = MAX_TRIS_FRAME;
    x.uvscale = (uvscale >= 0.125f && uvscale <= 16.0f) ? uvscale : 1.0f;
    if (!x.gte)
        return;
    u32 lg = rd32(v, G_LIGHT);
    if (!lg)
        return;
    for (int i = 0; i < 12; i++) x.light[i] = rdf(v, lg + 0xF8 + 4 * i);
    x.origin_tab = rd32(v, G_TEX_ORIGIN);
    if (!x.origin_tab)
        return;
    x.vx0 = (float)(s32)rd32(v, G_VIEW_X);
    x.vy0 = (float)(s32)rd32(v, G_VIEW_Y);
    x.vx1 = x.vx0 + (float)(s32)rd32(v, G_VIEW_W);
    x.vy1 = x.vy0 + (float)(s32)rd32(v, G_VIEW_H);
    x.vw = x.vx1 - x.vx0;
    if (!(x.vx1 > x.vx0 && x.vy1 > x.vy0)) {
        x.vx0 = -1e9f; x.vy0 = -1e9f; x.vx1 = 1e9f; x.vy1 = 1e9f;
        x.vw = 640.0f;
    } else {
        float mw = 0.5f * (x.vx1 - x.vx0), mh = 0.5f * (x.vy1 - x.vy0);
        x.vx0 -= mw; x.vx1 += mw; x.vy0 -= mh; x.vy1 += mh;
    }
    if (!calibrate(v, &x, far + FAR_IO, rd32(v, G_ONSET))) {
        st->calib_bad++;
        return;
    }

    horizon(&x, st);
    sky_draw(&x, st);

    /* which cells the game drew itself this frame */
    u8 detail[GW][GW];               /* 0 none, 1 S, 2 native / N */
    u8 nat[GW][GW];
    for (int j = 0; j < GW; j++) for (int i = 0; i < GW; i++) { detail[j][i] = 0; nat[j][i] = 0; }
    for (u32 k = 0; k < st->nnat && k < NAT_MAX; k++) {
        float d[3] = { (float)(st->nat[k][0] - cam.t[0]), (float)(st->nat[k][1] - cam.t[1]),
                       (float)(st->nat[k][2] - cam.t[2]) };
        float mxp = cam.cx[0] * d[0] + cam.cx[1] * d[1] + cam.cx[2] * d[2];
        float mzp = cam.cz[0] * d[0] + cam.cz[1] * d[1] + cam.cz[2] * d[2];
        float gx = (mxp + (float)lx) / (float)MESH, gz = (mzp + (float)lz) / (float)MESH;
        int ix = (int)(gx + (gx < 0 ? -0.5f : 0.5f)), iz = (int)(gz + (gz < 0 ? -0.5f : 0.5f));
        float ex = gx - (float)ix, ez = gz - (float)iz;
        if (ex > 0.25f || ex < -0.25f || ez > 0.25f || ez < -0.25f) continue;
        if (ix >= -GRID && ix <= GRID && iz >= -GRID && iz <= GRID)
            nat[iz + GRID][ix + GRID] = 1;
    }

    for (int sz = 0; sz < SZ; sz++)
        for (int sx = 0; sx < SX; sx++) {
            int near = 0;
            for (int k = 0; k < 16 && !near; k++) {
                int dxm = wrapi(sx * 4 + (k & 3) - cx, MX);
                int dzm = wrapi(sz * 4 + (k >> 2) - cz, MZ);
                if (ringof(dxm, dzm) <= NEAR_RING) near = 1;
            }
            st->cls[sz * SX + sx] = near ? CLS_NEAR : CLS_L2;
        }

    /* decide every cell's level first (skirts depend on the neighbours).
       BUILD 590: by how big the cell is on screen, not by its ring. Any cell
       wider than LOD_N of the viewport is drawn with the game's own mesh,
       however far away it is, so what you see in the distance is the same
       ground you will fly over (the S tile's 2048-unit quads, one texture
       each, were the squares and the "different" textures). */
    int want[NWANT], nwant = 0;
    Slot *nslot[GW][GW];
    for (int dz = -GRID; dz <= GRID; dz++)
        for (int dx = -GRID; dx <= GRID; dx++) {
            int mx = ((cx + dx) % MX + MX) % MX, mz = ((cz + dz) % MZ + MZ) % MZ;
            int cell = mz * MX + mx;
            int r = ringof(dx, dz);
            nslot[dz + GRID][dx + GRID] = 0;
            if (st->cls[(mz >> 2) * SX + (mx >> 2)] != CLS_NEAR) continue;
            const Entry *e = &st->e[cell];
            s32 px = dx * MESH - lx, pz = dz * MESH - lz;
            float ymid = 0.5f * ((float)e->ymin + (float)e->ymax);
            int vis = visible(&x, (float)(px + MESH / 2), (float)(pz + MESH / 2),
                              MESH / 2, (float)e->ymin, (float)e->ymax);
            float fp = !vis ? 0.0f : (r <= 1 ? 1.0f : footprint(&x, px, pz, ymid));
            int prio = 255 - (fp >= 0.5f ? 255 : (int)(fp * 510.0f));
            if (nat[dz + GRID][dx + GRID]) {
                detail[dz + GRID][dx + GRID] = 2;
                /* the window's own edge becomes the ring as you move on */
                if (r >= 1) {
                    Slot *sl = find_slot(st, cell);
                    if (sl) sl->used = st->frames;
                    else if (!st->bad[cell] && nwant < NWANT) want[nwant++] = (prio << 16) | cell;
                }
                continue;
            }
            Slot *sl = find_slot(st, cell);
            if (fp >= LOD_KEEP) {
                if (sl) sl->used = st->frames;
                else if (!st->bad[cell] && nwant < NWANT) want[nwant++] = (prio << 16) | cell;
            }
            if (sl && (fp >= LOD_N || (fp >= LOD_KEEP && sl->pad))) {
                sl->pad = 1;                     /* hysteresis: N sticks */
                nslot[dz + GRID][dx + GRID] = sl;
                detail[dz + GRID][dx + GRID] = 2;
                continue;
            }
            if (sl) sl->pad = 0;
            detail[dz + GRID][dx + GRID] = 1;
        }

    for (int ring = 0; ring <= GRID && x.budget > 0; ring++)
        for (int dz = -ring; dz <= ring; dz++)
            for (int dx = -ring; dx <= ring; dx++) {
                if (ringof(dx, dz) != ring) continue;
                u8 lvl = detail[dz + GRID][dx + GRID];
                if (lvl == 0 || nat[dz + GRID][dx + GRID]) continue;
                int mx = ((cx + dx) % MX + MX) % MX, mz = ((cz + dz) % MZ + MZ) % MZ;
                const Entry *e = &st->e[mz * MX + mx];
                s32 px = dx * MESH - lx, pz = dz * MESH - lz;
                float ax = (float)(px > 0 ? px : (px + MESH < 0 ? -(px + MESH) : 0));
                float az = (float)(pz > 0 ? pz : (pz + MESH < 0 ? -(pz + MESH) : 0));
                if (fsqrt(ax * ax + az * az) > cam.horizon)
                    continue;
                if (!visible(&x, (float)(px + MESH / 2), (float)(pz + MESH / 2),
                             MESH / 2, (float)e->ymin, (float)e->ymax))
                    continue;
                HOST_TILE(lvl, mz * MX + mx, px, pz);
                Mesh me;
                if (lvl == 2 && nslot[dz + GRID][dx + GRID]
                    && x.budget < (int)nslot[dz + GRID][dx + GRID]->ntri + N_RESERVE
                    && ring > 1)
                    lvl = 1;                     /* out of budget: S */
                if (lvl == 2) {
                    mesh_n(nslot[dz + GRID][dx + GRID], &me);
                } else {
                    u8 sk = 0;
                    int nb[4][2] = { { dx, dz - 1 }, { dx + 1, dz }, { dx, dz + 1 }, { dx - 1, dz } };
                    for (int k = 0; k < 4; k++) {
                        int ix = nb[k][0], iz = nb[k][1];
                        if (ix < -GRID || ix > GRID || iz < -GRID || iz > GRID) continue;
                        if (detail[iz + GRID][ix + GRID] == 2) sk |= (u8)(1 << k);
                    }
                    mesh_s(st, e, sk, &me);
                }
                emit(&x, &me, px, pz);
            }

    int order[N2], nord = 0;
    float dist[N2];
    s32 posx[N2], posz[N2];
    for (int s = 0; s < N2; s++) {
        if (st->cls[s] != CLS_L2) continue;
        int sx = s % SX, sz = s / SX;
        s32 rx = wrapi(sx * 4 * MESH + 2 * MESH - fx, WRAP_X);
        s32 rz = wrapi(sz * 4 * MESH + 2 * MESH - fz, WRAP_Z);
        float ax = (float)(rx < 0 ? -rx : rx) - 2.0f * MESH;
        float az = (float)(rz < 0 ? -rz : rz) - 2.0f * MESH;
        if (ax < 0) ax = 0;
        if (az < 0) az = 0;
        float dn = fsqrt(ax * ax + az * az);
        if (dn > cam.horizon) continue;
        const Entry *e = &st->e[N1 + s];
        if (!visible(&x, (float)rx, (float)rz, 2.0f * MESH, (float)e->ymin, (float)e->ymax))
            continue;
        int j = nord++;
        while (j > 0 && dist[order[j - 1]] > dn) {
            order[j] = order[j - 1];
            j--;
        }
        order[j] = s;
        dist[s] = dn; posx[s] = rx; posz[s] = rz;
    }
    for (int i = 0; i < nord && x.budget > 0; i++) {
        int s = order[i];
        int sx = s % SX, sz = s / SX;
        const Entry *e = &st->e[N1 + s];
        u8 sk = 0;
        int nb[4][2] = { { sx, sz - 1 }, { sx + 1, sz }, { sx, sz + 1 }, { sx - 1, sz } };
        for (int k = 0; k < 4; k++) {
            int nx = (nb[k][0] + SX) % SX, nz = (nb[k][1] + SZ) % SZ;
            int ns = nz * SX + nx;
            if (st->cls[ns] == CLS_NEAR
                || ((st->e[N1 + ns].flags ^ e->flags) & 1))
                sk |= (u8)(1 << k);
        }
        HOST_TILE(3, s, posx[s], posz[s]);
        Mesh me;
        mesh_s(st, e, sk, &me);
        emit(&x, &me, posx[s], posz[s]);
    }
    st->last_tiles = (u32)x.tiles;

    /* read the missing full-detail meshes, nearest first, a few per frame */
    for (int a = 1; a < nwant; a++) {
        int w = want[a], j = a;
        while (j > 0 && want[j - 1] > w) { want[j] = want[j - 1]; j--; }
        want[j] = w;
    }
    for (int a = 0, done = 0; a < nwant && done < LOADS_PER_FRAME; a++) {
        Slot *sl = victim(st);
        if (!sl) break;
        done++;
        if (load_mesh(st, want[a] & 0xFFFF, sl)) {
            sl->used = st->frames;
            st->loads++;
        } else {
            st->load_fail++;
            st->bad[want[a] & 0xFFFF] = 1;   /* never again: S stands in */
        }
    }
}

/* After the world map's allocator 0x75AB50 (its only call). wm0.far is
   static data in BSS, so it is read ONCE per session, here, while the world
   map is still loading -- never while its block streamer is running, and
   nothing reads a file per frame (BUILD 587 read wm0.map meshes on the fly,
   which stalled the streamer: the Highwind stopped at unloaded blocks). */
__attribute__((section(".text.worldfar_alloc")))
void worldfar_alloc(State *st, g2h_fn g2h, callx_fn call)
{
    Env env = { g2h, call, st };
    st->zoom = 0.0f;
    st->tilt = 0.0f;
    st->tilt_units = 0;
    st->zoom_added = 0;
    st->nnat = 0;
    st->hz_frame = 0;
    {   /* the sky objects belong to this world map session */
        u8 *z = (u8 *)&st->sky;
        for (u32 i = 0; i < sizeof st->sky; i++) z[i] = 0;
    }
    if (st->magic == 0x52414657u || st->failed_base >= 3)
        return;
    u32 base = rd32(&env, G_WORLD_BASE);
    if (!base)
        return;
    if (load(&env, base)) {
        st->magic = 0x52414657u;
    } else {
        st->magic = 0;
        st->failed_base++;
    }
}

__attribute__((section(".text.worldfar_draw")))
void worldfar_draw(State *st, g2h_fn g2h, callx_fn call, float uvscale)
{
    Env env = { g2h, call, st };
    draw(&env, st, uvscale);
    st->nnat = 0;                    /* the next frame's window starts empty */
    call(F_RESET_GTE, 0);
}

/* ------------------------------------------------------------ input */
static u8 *input_obj(u8 **got)
{
    if (!got) return 0;
    u8 *p = *got;
    if (!p) return 0;
    p = *(u8 **)(p + 0);
    if (!p) return 0;
    p = *(u8 **)(p + 8);
    if (!p) return 0;
    p = *(u8 **)(p + 0);
    if (!p) return 0;
    return *(u8 **)(p + 0x88);
}

static float stick(float v)
{
    if (v > STICK_DEADZONE) return (v - STICK_DEADZONE) / (1.0f - STICK_DEADZONE);
    if (v < -STICK_DEADZONE) return (v + STICK_DEADZONE) / (1.0f - STICK_DEADZONE);
    return 0.0f;
}

static float mult(Env *v)
{
    s32 m = (s32)rd32(v, G_MOVE_MULT);
    if (m < 1) m = 1;
    if (m > 4) m = 4;
    return (float)m;
}

/* ------------------------------------------------------------ camera
 * FFNx's world camera (camera.cpp): pitch -95..-175 degrees, zoom up to
 * 35000 on the triggers, right stick for the view.
 *   ZL / ZR     zoom out / in
 *   up/down     tilt: up looks toward the horizon, down at the ground
 *   R3          both back to the game's own camera
 * BUILD 590: both go INTO the game's camera instead of being laid over its
 * result. 589 moved the camera back along its view axis (0xDE6A20) and
 * turned 0xDFC448 after the update; the models, their shadows and the stock
 * sky are placed from the update's own pitch and distance, so they slid off
 * the ground and the sky left the horizon as you zoomed or tilted. Now:
 *   zoom   is added to the camera distance 0xDFC478 for the duration of the
 *          update (phase 0 before, phase 1 after -- the stored distance is
 *          never changed);
 *   tilt   is added, in 4096-per-turn units, to what 0x74F916 (the camera
 *          pitch) returns, by the cave at its end, clamped to 95..175
 *          degrees -- so every consumer of the pitch sees the same camera. */
#define G_CAM_DIST      0xDFC478u
#define PITCH_LO        1081        /* 95 degrees: 5 below the horizontal */
#define PITCH_HI        1991        /* 175 degrees: 85 below */
#define TILT_UNITS      (TILT_STEP * 4096.0f / 6.28318531f)
__attribute__((section(".text.worldfar_camera")))
void worldfar_camera(State *st, g2h_fn g2h, callx_fn call, u8 **got, u32 phase)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    if (phase != 0) {
        if (st->zoom_added) {
            wr32(v, G_CAM_DIST, (u32)((s32)rd32(v, G_CAM_DIST) - st->zoom_added));
            st->zoom_added = 0;
        }
        return;
    }
    st->zoom_added = 0;
    if (rd32(v, G_MAP_TYPE) != 0) {
        st->tilt_units = 0;
        return;
    }
    u8 *p = input_obj(got);
    if (!p) return;
    float ry = stick(*(float *)(p + 0x40) - *(float *)(p + 0x44));
    unsigned long long buttons = *(unsigned long long *)(p + 0x20);
    float mm = mult(v);
    float zoom = st->zoom, tilt = st->tilt;
    if (!(zoom >= 0.0f && zoom < 100000.0f)) zoom = 0.0f;
    if (!(tilt > -2048.0f && tilt < 2048.0f)) tilt = 0.0f;
    if (buttons & BTN_R3) {
        zoom = 0.0f;
        tilt = 0.0f;
    }
    if (buttons & BTN_ZL) zoom += ZOOM_STEP * mm;
    if (buttons & BTN_ZR) zoom -= ZOOM_STEP * mm;
    if (ry != 0.0f) {
        /* the game's own pitch (last update, recorded by the cave), to keep
           the sum inside the range */
        s32 base = st->pitch_seen;
        if (base > 0 && base < 4096) {
            tilt -= TILT_UNITS * mm * ry;
            if ((float)base + tilt < (float)PITCH_LO) tilt = (float)(PITCH_LO - base);
            if ((float)base + tilt > (float)PITCH_HI) tilt = (float)(PITCH_HI - base);
        }
    }
    st->tilt = tilt;
    st->tilt_units = (s32)(tilt + (tilt < 0.0f ? -0.5f : 0.5f));
    s32 dist = (s32)rd32(v, G_CAM_DIST);
    float room = ZOOM_MAX_DIST - (float)dist;
    if (room < 0.0f) room = 0.0f;
    if (zoom > room) zoom = room;
    if (zoom < 0.0f) zoom = 0.0f;
    st->zoom = zoom;
    s32 add = (s32)zoom;
    if (add > 0) {
        wr32(v, G_CAM_DIST, (u32)(dist + add));
        st->zoom_added = add;
    }
}

/* ------------------------------------------------------------ input
 * BUILD 588. On foot, the stock update moves the player along the WORLD axes
 * from the arrow keys (0x74EC3F..0x74ED32: left -x, right +x, up -z, down
 * +z, facing -1024/1024/2048/0), and spins the camera heading 0xDFC484 by a
 * fixed step while left/right is held -- that is what ran Cloud in circles
 * and why "up" was never quite into the screen.
 *
 *  worldfar_move   around the update's call of 0x762E87 (the move): with
 *                  the left stick held, (dx, dz) becomes the stock speed in
 *                  the stick's exact direction relative to the CAMERA, and
 *                  the facing to match (360-degree analogue movement).
 *  worldfar_input  around the whole update: the arrow keys' share of the
 *                  stock spin is taken back out and the stick turns the
 *                  heading instead, at the stock rate scaled by how far
 *                  sideways it points (straight left = holding left), so
 *                  the camera swings round with you as it did in the
 *                  original; L1/R1 and the d-pad are untouched; the right
 *                  stick turns it directly. The camera's smoothing of the heading
 *                  (0xDFC474, done at the end of the update) is redone from
 *                  the final heading so it answers the same frame.
 *
 * The Highwind (view 3), the front view (2), the Tiny Bronco, the buggy and
 * the submarine keep their stock controls; only the right stick is added
 * there. Out of player control nothing moves. */
#define SPIN_STEP       8.0f         /* the stock turn: 8 x mult x (2 - up/down) */
#define G_KEYS          0x9A85D4u    /* held PSX keys */
#define F_PLAYER_MODEL  0x761735u    /* () -> the player's world model id */
#define K_L1 0x0004u
#define K_R1 0x0008u
#define K_UP 0x1000u
#define K_RIGHT 0x2000u
#define K_DOWN 0x4000u
#define K_LEFT 0x8000u
#define MOVE_MIN        0.35f
#define G_CAM_ROTY      0xDFC474u    /* smoothed heading the camera uses */
#define G_ENTITY        0xE39AD8u    /* -> the current entity (the player here) */

static float fatan2(float y, float x)
{
    float ax = fabs_(x), ay = fabs_(y);
    if (ax < 1e-20f && ay < 1e-20f) return 0.0f;
    float a = ax > ay ? ay / ax : ax / ay;
    float s = a * a;
    float r = ((-0.0464964749f * s + 0.15931422f) * s - 0.327622764f) * s * a + a;
    if (ay > ax) r = 1.57079637f - r;
    if (x < 0) r = 3.14159274f - r;
    if (y < 0) r = -r;
    return r;
}

static int on_foot(Env *v)
{
    u32 vt = rd32(v, G_VIEW_TYPE);
    if (rd32(v, G_MAP_TYPE) != 0 || vt == 2 || vt == 3
        || rd32(v, G_CONTROL) == 0)
        return 0;
    /* walkers only: Cloud, Tifa, Cid and the chocobos. The Tiny Bronco,
       the buggy and the submarine keep their stock (vanilla) controls. */
    u32 m = v->call(F_PLAYER_MODEL, 0);
    return m <= 2 || m == 4 || m == 19 || m == 41 || m == 42;
}

/* The heading change 0x74EA48 makes from the keys (0x74EE.. two branches):
   L1 and the left key turn it down, R1 and the right key up, each by
   8 x mult x (2 - up/down held); with down held the arrow keys swap.
   *total is the whole change, *arrows the arrow keys' share of it. */
static void stock_spin(u32 keys, s32 m, s32 *total, s32 *arrows)
{
    s32 unit = 8 * m * ((keys & (K_UP | K_DOWN)) ? 1 : 2);
    int down = (keys & K_DOWN) != 0;
    s32 a = (keys & (down ? K_RIGHT : K_LEFT)) ? 1 : 0;
    s32 b = (keys & (down ? K_LEFT : K_RIGHT)) ? 1 : 0;
    s32 l1 = (keys & K_L1) ? 1 : 0, r1 = (keys & K_R1) ? 1 : 0;
    *total = unit * ((r1 + b) - (l1 + a));
    *arrows = unit * (b - a);
}

/* the left stick, in the world: unit (wx, wz) and its magnitude */
static float stick_world(Env *v, u8 **got, float *wx, float *wz, float *side)
{
    u8 *p = input_obj(got);
    if (!p) return 0.0f;
    float sx = *(float *)(p + 0x38) - *(float *)(p + 0x3C);
    float sy = *(float *)(p + 0x30) - *(float *)(p + 0x34);
    float mag = fsqrt(sx * sx + sy * sy);
    if (mag < MOVE_MIN) return 0.0f;
    if (mag > 1.0f) mag = 1.0f;
    /* camera right and forward on the ground, from its rotation rows */
    float r0 = (float)rds16(v, G_CAM_ROT + 0) / 4096.0f;
    float r2 = (float)rds16(v, G_CAM_ROT + 4) / 4096.0f;
    float f0 = (float)rds16(v, G_CAM_ROT + 12) / 4096.0f;
    float f2 = (float)rds16(v, G_CAM_ROT + 16) / 4096.0f;
    float rl = fsqrt(r0 * r0 + r2 * r2), fl = fsqrt(f0 * f0 + f2 * f2);
    if (rl < 1e-3f || fl < 1e-3f) return 0.0f;
    r0 /= rl; r2 /= rl; f0 /= fl; f2 /= fl;
    float x = r0 * sx + f0 * sy, z = r2 * sx + f2 * sy;
    float l = fsqrt(x * x + z * z);
    if (l < 1e-4f) return 0.0f;
    *wx = x / l;
    *wz = z / l;
    *side = sx / mag;
    return mag;
}

__attribute__((section(".text.worldfar_move")))
void worldfar_move(State *st, g2h_fn g2h, callx_fn call, u8 *ctx, u32 phase)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    if (phase != 0 || !on_foot(v))
        return;
    u8 **got = (u8 **)st->got;
    float wx, wz, side;
    if (stick_world(v, got, &wx, &wz, &side) <= 0.0f)
        return;
    u32 esp = ld32(ctx + 0x10);
    s32 dx = (s32)rd32(v, esp + 4), dz = (s32)rd32(v, esp + 8);
    if (!dx && !dz)
        return;                              /* not moving (or blocked) */
    s32 ax = dx < 0 ? -dx : dx, az = dz < 0 ? -dz : dz;
    float speed = (float)(ax > az ? ax : az);
    if (ax && az) speed *= 4.0f / 3.0f;      /* the diagonals are 3/4 each */
    wr32(v, esp + 4, (u32)(s32)(wx * speed));
    wr32(v, esp + 8, (u32)(s32)(wz * speed));
    st->facing = (s32)(fatan2(wx, wz) * (2048.0f / 3.14159274f));
    st->facing_ok = 1;
}

__attribute__((section(".text.worldfar_input")))
void worldfar_input(State *st, g2h_fn g2h, callx_fn call, u8 **got, u32 phase)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    st->got = (u64)(unsigned long)got;
    if (rd32(v, G_MAP_TYPE) != 0) {
        st->saved_ok = 0;
        return;
    }
    if (phase == 0) {
        st->front_saved = (s32)rd32(v, G_CAM_FRONT);
        st->rot_saved = (s32)rd32(v, G_CAM_ROTY);
        st->saved_ok = 1;
        st->facing_ok = 0;
        return;
    }
    if (!st->saved_ok)
        return;
    st->saved_ok = 0;
    u8 *p = input_obj(got);
    float rx = p ? stick(*(float *)(p + 0x48) - *(float *)(p + 0x4C)) : 0.0f;
    s32 front = (s32)rd32(v, G_CAM_FRONT);
    if (on_foot(v)) {
        float wx, wz, side;
        float mag = stick_world(v, got, &wx, &wz, &side);
        if (mag > 0.0f) {
            /* The stick drives the turn the arrow keys drove in the stock
               game, in proportion: straight sideways turns exactly as fast
               as holding left/right did (16 x mult), a diagonal half as
               fast (the stock up/down halving), straight up not at all,
               easing to nothing towards straight down so running at the
               camera never whips it round. L1/R1 keep their stock turn.
               A change the keys do not explain is left alone. */
            s32 d = wrapi(front - st->front_saved, 4096);
            s32 total, arrows;
            stock_spin(rd32(v, G_KEYS) & 0xFFFFu, (s32)mult(v), &total, &arrows);
            if (d == total) {
                front = st->front_saved + (total - arrows);
                if (rx == 0.0f) {
                    float up = 1.0f;
                    u8 *p = input_obj(got);
                    if (p) {
                        float sy = *(float *)(p + 0x30) - *(float *)(p + 0x34);
                        float c = sy / mag;
                        if (c < 0.0f) up = 1.0f + (c < -1.0f ? -1.0f : c);
                    }
                    float turn = 2.0f * SPIN_STEP * mult(v) * mag * side
                               * fabs_(side) * up;
                    front += (s32)(turn + (turn < 0.0f ? -0.5f : 0.5f));
                }
            }
        }
        if (st->facing_ok) {
            u32 ent = rd32(v, G_ENTITY);
            if (ent) {
                wr16(v, ent + 0x40, (u16)(s16)st->facing);
                wr16(v, ent + 0x4C, (u16)(s16)st->facing);
            }
        }
    }
    st->facing_ok = 0;
    if (rd32(v, G_CONTROL) != 0)
        front += (s32)(YAW_STEP * mult(v) * rx);
    /* R3: the camera swings back behind the player (FFNx's reset: front =
       2048 - facing, the heading from which "up" runs the way he faces);
       worldfar_camera resets zoom and tilt on the same click */
    if (p && rd32(v, G_CONTROL) != 0
        && (*(unsigned long long *)(p + 0x20) & BTN_R3)) {
        u32 ent = rd32(v, G_ENTITY);
        if (ent)
            front = 2048 - (s32)rds16(v, ent + 0x40);
    }
    front = ((front % 4096) + 4096) % 4096;
    wr32(v, G_CAM_FRONT, (u32)front);
    /* the heading smoothing the update did at its end (0x74F78D..0x74F873,
       the branch it always takes), redone from the final heading */
    s32 r = st->rot_saved;
    if (r < front - 0x800) r += 0x1000;
    else if (r > front + 0x800) r -= 0x1000;
    if (rd32(v, G_MOVE_MULT) == 1) r = (r * 31 + front) >> 5;
    else r = (r * 15 + front) >> 4;
    wr32(v, G_CAM_ROTY, (u32)r);
}
