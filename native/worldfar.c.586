/*
 * worldfar.c -- the far-field terrain pass (BUILD 585, ff7nx_worldfar).
 *
 * Three entry points (BUILD 586):
 *
 *  worldfar_bend    after EVERY world terrain transform (0x10F28B0, the
 *                   port's replacement for 0x75F0AD): FFNx's spherical world
 *                   applied to the transformed vertices on the CPU. World
 *                   terrain is submitted as pre-transformed (TL) vertices --
 *                   0x75F68C writes clip/w -- so the lmain_vv shader never
 *                   sees it; this is where the terrain must bend.
 *  worldfar_draw    after world_sub_751EFC: the rest of the planet from
 *                   wm0.far. Per tile it sets the GTE translation and runs
 *                   the native transform (so the tile is bent like the
 *                   window), then projects, lights, culls and writes the TL
 *                   triangles itself straight into the per-texture graphics
 *                   objects -- the job 0x75F263 + 0x75F68C do for the window,
 *                   minus their per-vertex x87 emulation and the screen-centre
 *                   triangle splitting that only served the old sink.
 *  worldfar_camera  after the camera update 0x74E8CE: right stick up/down
 *                   tilts the view (FFNx 5..85 degrees), left/right zooms
 *                   (FFNx up to 35000), R3 resets both.
 *
 * It is compiled position-independent (every internal reference PC-relative,
 * every module address arrives as a pointer or a constant guest address) so
 * the same bytes run wherever the build places them. HOST_TEST builds it
 * natively against a fake guest for tests/test_worldfar.py.
 */
#include <stdint.h>

typedef uint8_t u8;
typedef int16_t s16;
typedef uint16_t u16;
typedef int32_t s32;
typedef uint32_t u32;
typedef int64_t s64;

typedef u8 *(*g2h_fn)(u32 guest);
typedef u32 (*callx_fn)(u32 x86, u32 nargs, ...);

/* ---- guest globals (x86 VAs, ff7_en 1.02) ---- */
#define G_MAP_TYPE      0xE045E8u   /* 0 = overworld */
#define G_PLAYER_POS    0xE04918u   /* int x, y, z */
#define G_CAM_ROT       0xDFC448u   /* s16[9] */
#define G_CAM_DELTA_Y   0xDE6A04u
#define G_GTE           0x90AAF0u   /* -> state; translation int[3] at +0x22 */
#define G_WORLD_BASE    0xE2D600u   /* the world map's one allocation */
#define G_ONSET         0xE045D8u
#define G_PRIM_CUR      0xDE6A10u
#define G_PRIM_BASE     0xDF5444u
#define G_VFLAGS        0xE397B8u   /* u32 per vertex: inside-x | inside-y<<8 */

#define F_RESET_GTE     0x74D3A7u   /* SetRot(DFC448), SetTrans(DE6A20) */
#define F_APPLY         0x662ECCu   /* out = R*v + T (s16 v) */
#define F_NAME          0x74CA00u   /* (kind, idx) -> "...wm/WM<idx><ext>" */
#define F_READ          0x7593CDu   /* (name, offset, size, dest) -> 0 ok */
#define F_TRANSFORM     0x75F0ADu
#define F_ALLOC_SHAPES  0x66E272u   /* (n, graphics object) -> 0 if none */
#define F_DRAW_ENABLED  0x74C969u   /* the world's own per-triangle gate */

#define G_VERTS_F       0xE38338u   /* float x,y,z per vertex (0xC) */
#define G_COMBINED      0xE39738u   /* model -> clip, row vectors, 4x4 */
#define G_TEX_OBJS      0xE2BBD8u   /* graphics object per texture id */
#define G_TEX_ORIGIN    0xE2D168u   /* -> u16 u, v origin per texture id */
#define G_LIGHT         0xE360F4u   /* -> +0xF8 the 3x4 light matrix */
#define G_VIEW_X        0xE2C424u
#define G_VIEW_Y        0xE2C428u
#define G_VIEW_W        0xDE68F8u
#define G_VIEW_H        0xDE67E8u
#define G_CAM_TRANS     (0xDE6A20u + 0x12u)
#define TL_STRIDE       0x20u       /* x,y,z,rhw,colour,specular,u,v */

/* ---- layout shared with ff7nx_worldfar.py (checked there) ---- */
#ifndef PRIM_BYTES
#define PRIM_BYTES      0x80000u
#endif
#define FAR_OFF         (0xA6800u + 2u * PRIM_BYTES)
#define FAR_NAME        0x000u
#define FAR_SCRATCH     0x080u
#define FAR_DATA        0x100u
#ifndef FAR_MAX
#define FAR_MAX         0x240000u
#endif
#define FAR_SLACK       0x1000u     /* the transform always reads 122 verts */

#define MX 36
#define MZ 28
#define SX 9
#define SZ 7
#define N1 (MX * MZ)
#define N2 (SX * SZ)
#define MESH 8192
#define WRAP_X 0x48000
#define WRAP_Z 0x38000

#define NEAR_RING       3           /* L1 around the 5x5 window */
#define MAX_TRIS_FRAME  12000
#define ZOOM_MAX_DIST   35000.0f    /* FFNx getMaxZoomDist */
#define ZOOM_STEP       250.0f      /* units per camera update at full tilt */
#define STICK_DEADZONE  0.2f
#define TILT_STEP       0.02f       /* radians per camera update at full tilt */
#define TILT_MIN        0.0873f     /* 5 degrees below horizontal (FFNx -95) */
#define TILT_MAX        1.4835f     /* 85 degrees (FFNx -175) */
#define G_CAM_TRANS_Z   (0xDE6A20u + 0x12u + 8u)
#define SPHERE_R        250000.0f
#define MOUNTAIN        4000.0f

typedef struct {
    u32 tris, verts, norms;         /* file offsets */
    u16 ntri;
    u16 sk_first[4];
    u8  sk_n[4];
    u8  nverts, flags;
    s16 ymin, ymax;
} Entry;                             /* == ENTRY_FMT, 32 bytes */

typedef struct {
    u32 magic;                       /* 'WFAR' once loaded */
    u32 base;                        /* world allocation it was loaded into */
    u32 failed_base;                 /* do not retry a failed load there */
    u32 data;                        /* guest address of the file */
    u32 frames;
    u32 last_tris;                   /* diagnostics */
    u32 last_tiles;
    float zoom;                      /* extra camera distance (right stick) */
    float tilt;                      /* camera pitch offset, radians */
    u32 nv_hint;                     /* vertices the next transform needs */
    Entry e[N1 + N2];
    u8 cls[N2];                      /* per-frame sector class */
} State;

#define CLS_L2 0
#define CLS_NEAR 1

typedef struct {
    g2h_fn g2h;
    callx_fn call;
    State *st;
} Env;

/* The port translates guest addresses page by page (4 KB); a value that
   does not cross a page is one translation. */
static u8 rd8(Env *v, u32 g) { return *v->g2h(g); }
static u32 rd32(Env *v, u32 g)
{
    if ((g & 0xFFFu) <= 0xFFCu) {
        const u8 *p = v->g2h(g);
        return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16)
             | ((u32)p[3] << 24);
    }
    return (u32)rd8(v, g) | ((u32)rd8(v, g + 1) << 8)
         | ((u32)rd8(v, g + 2) << 16) | ((u32)rd8(v, g + 3) << 24);
}
static s16 rds16(Env *v, u32 g)
{
    return (s16)((u16)rd8(v, g) | ((u16)rd8(v, g + 1) << 8));
}
static void wr8(Env *v, u32 g, u8 x) { *v->g2h(g) = x; }
static void wr32(Env *v, u32 g, u32 x)
{
    if ((g & 0xFFFu) <= 0xFFCu) {
        u8 *p = v->g2h(g);
        p[0] = (u8)x; p[1] = (u8)(x >> 8); p[2] = (u8)(x >> 16);
        p[3] = (u8)(x >> 24);
        return;
    }
    wr8(v, g, (u8)x); wr8(v, g + 1, (u8)(x >> 8));
    wr8(v, g + 2, (u8)(x >> 16)); wr8(v, g + 3, (u8)(x >> 24));
}
static void wr16(Env *v, u32 g, u16 x) { wr8(v, g, (u8)x); wr8(v, g + 1, (u8)(x >> 8)); }

static float fsqrt(float x)
{
#ifdef HOST_TEST
    return __builtin_sqrtf(x);
#else
    float r;
    __asm__("fsqrt %s0, %s1" : "=w"(r) : "w"(x));
    return r;
#endif
}
static float fabs_(float x) { return x < 0 ? -x : x; }

static int wrapi(int d, int period)
{
    int h = period / 2;
    while (d >= h) d -= period;
    while (d < -h) d += period;
    return d;
}

/* ------------------------------------------------------------ loading */
static int load(Env *v, u32 base)
{
    State *st = v->st;
    u32 far = base + FAR_OFF;
    u32 data = far + FAR_DATA;
    u32 name = v->call(F_NAME, 2, 0, 0);
    if (!name)
        return 0;
    /* copy "...WM0.MAP" and turn the extension into .FAR */
    u32 i = 0, dot = 0;
    for (; i < 120; i++) {
        u8 c = rd8(v, name + i);
        wr8(v, far + FAR_NAME + i, c);
        if (c == '.') dot = i;
        if (!c) break;
    }
    if (i >= 120 || !dot)
        return 0;
    wr8(v, far + dot + 1, 'F'); wr8(v, far + dot + 2, 'A');
    wr8(v, far + dot + 3, 'R'); wr8(v, far + dot + 4, 0);
    if (v->call(F_READ, 4, far + FAR_NAME, 0, 32, data) != 0)
        return 0;
    if (rd32(v, data) != 0x52414657u /* 'WFAR' */ || rd32(v, data + 4) != 1
        || rd32(v, data + 8) != N1 || rd32(v, data + 12) != N2
        || rd32(v, data + 24) != 32)
        return 0;
    u32 total = rd32(v, data + 20);
    if (total <= 32 || total > FAR_MAX - FAR_DATA - FAR_SLACK)
        return 0;
    if (v->call(F_READ, 4, far + FAR_NAME, 32, total - 32, data + 32) != 0)
        return 0;
    if (rd32(v, data) != 0x52414657u)
        return 0;
    u32 at = data + 32;
    for (u32 k = 0; k < N1 + N2; k++, at += 32) {
        Entry *e = &st->e[k];
        e->tris = rd32(v, at);
        e->verts = rd32(v, at + 4);
        e->norms = rd32(v, at + 8);
        e->ntri = (u16)rds16(v, at + 12);
        for (int j = 0; j < 4; j++)
            e->sk_first[j] = (u16)rds16(v, at + 14 + 2 * j);
        for (int j = 0; j < 4; j++)
            e->sk_n[j] = rd8(v, at + 22 + j);
        e->nverts = rd8(v, at + 26);
        e->flags = rd8(v, at + 27);
        e->ymin = rds16(v, at + 28);
        e->ymax = rds16(v, at + 30);
        if (e->nverts > 120 || e->tris >= total || e->verts >= total
            || e->norms >= total)
            return 0;
    }
    st->data = data;
    return 1;
}

/* ------------------------------------------------------------ maths */
static double dabs(double x) { return x < 0 ? -x : x; }

static double dsqrt(double x)
{
#ifdef HOST_TEST
    return __builtin_sqrt(x);
#else
    double r;
    __asm__("fsqrt %d0, %d1" : "=w"(r) : "w"(x));
    return r;
#endif
}

/* sin/cos for |x| <= ~2, exp for |x| <= ~2: Taylor, double, ample here */
static void dsincos(double x, double *s, double *c)
{
    double x2 = x * x, t = x, ss = x, cc = 1.0, u = 1.0;
    for (int k = 1; k < 9; k++) {
        t *= -x2 / (double)((2 * k) * (2 * k + 1));
        ss += t;
        u *= -x2 / (double)((2 * k - 1) * (2 * k));
        cc += u;
    }
    *s = ss;
    *c = cc;
}

static double dexp(double x)
{
    int halvings = 0;
    while (dabs(x) > 0.5 && halvings < 16) { x *= 0.5; halvings++; }
    double t = 1.0, r = 1.0;
    for (int k = 1; k < 14; k++) { t *= x / (double)k; r += t; }
    while (halvings--) r *= r;
    return r;
}

static float rdf(Env *v, u32 g) { u32 b = rd32(v, g); float f; __builtin_memcpy(&f, &b, 4); return f; }
static void wrf(Env *v, u32 g, float f) { u32 b; __builtin_memcpy(&b, &f, 4); wr32(v, g, b); }

/* The combined model->clip matrix as the shader sees it: clip_c =
   sum_r p_r * m[r*4+c] + m[12+c]. */
typedef struct { double m[16]; } M4;

static void read_m4(Env *v, u32 g, M4 *o)
{
    for (int i = 0; i < 16; i++) o->m[i] = rdf(v, g + 4 * i);
}

static int invert(const M4 *a, M4 *o)
{
    const double *m = a->m;
    double inv[16];
    inv[0] = m[5]*m[10]*m[15] - m[5]*m[11]*m[14] - m[9]*m[6]*m[15] + m[9]*m[7]*m[14] + m[13]*m[6]*m[11] - m[13]*m[7]*m[10];
    inv[4] = -m[4]*m[10]*m[15] + m[4]*m[11]*m[14] + m[8]*m[6]*m[15] - m[8]*m[7]*m[14] - m[12]*m[6]*m[11] + m[12]*m[7]*m[10];
    inv[8] = m[4]*m[9]*m[15] - m[4]*m[11]*m[13] - m[8]*m[5]*m[15] + m[8]*m[7]*m[13] + m[12]*m[5]*m[11] - m[12]*m[7]*m[9];
    inv[12] = -m[4]*m[9]*m[14] + m[4]*m[10]*m[13] + m[8]*m[5]*m[14] - m[8]*m[6]*m[13] - m[12]*m[5]*m[10] + m[12]*m[6]*m[9];
    inv[1] = -m[1]*m[10]*m[15] + m[1]*m[11]*m[14] + m[9]*m[2]*m[15] - m[9]*m[3]*m[14] - m[13]*m[2]*m[11] + m[13]*m[3]*m[10];
    inv[5] = m[0]*m[10]*m[15] - m[0]*m[11]*m[14] - m[8]*m[2]*m[15] + m[8]*m[3]*m[14] + m[12]*m[2]*m[11] - m[12]*m[3]*m[10];
    inv[9] = -m[0]*m[9]*m[15] + m[0]*m[11]*m[13] + m[8]*m[1]*m[15] - m[8]*m[3]*m[13] - m[12]*m[1]*m[11] + m[12]*m[3]*m[9];
    inv[13] = m[0]*m[9]*m[14] - m[0]*m[10]*m[13] - m[8]*m[1]*m[14] + m[8]*m[2]*m[13] + m[12]*m[1]*m[10] - m[12]*m[2]*m[9];
    inv[2] = m[1]*m[6]*m[15] - m[1]*m[7]*m[14] - m[5]*m[2]*m[15] + m[5]*m[3]*m[14] + m[13]*m[2]*m[7] - m[13]*m[3]*m[6];
    inv[6] = -m[0]*m[6]*m[15] + m[0]*m[7]*m[14] + m[4]*m[2]*m[15] - m[4]*m[3]*m[14] - m[12]*m[2]*m[7] + m[12]*m[3]*m[6];
    inv[10] = m[0]*m[5]*m[15] - m[0]*m[7]*m[13] - m[4]*m[1]*m[15] + m[4]*m[3]*m[13] + m[12]*m[1]*m[7] - m[12]*m[3]*m[5];
    inv[14] = -m[0]*m[5]*m[14] + m[0]*m[6]*m[13] + m[4]*m[1]*m[14] - m[4]*m[2]*m[13] - m[12]*m[1]*m[6] + m[12]*m[2]*m[5];
    inv[3] = -m[1]*m[6]*m[11] + m[1]*m[7]*m[10] + m[5]*m[2]*m[11] - m[5]*m[3]*m[10] - m[9]*m[2]*m[7] + m[9]*m[3]*m[6];
    inv[7] = m[0]*m[6]*m[11] - m[0]*m[7]*m[10] - m[4]*m[2]*m[11] + m[4]*m[3]*m[10] + m[8]*m[2]*m[7] - m[8]*m[3]*m[6];
    inv[11] = -m[0]*m[5]*m[11] + m[0]*m[7]*m[9] + m[4]*m[1]*m[11] - m[4]*m[3]*m[9] - m[8]*m[1]*m[7] + m[8]*m[3]*m[5];
    inv[15] = m[0]*m[5]*m[10] - m[0]*m[6]*m[9] - m[4]*m[1]*m[10] + m[4]*m[2]*m[9] + m[8]*m[1]*m[6] - m[8]*m[2]*m[5];
    double det = m[0]*inv[0] + m[1]*inv[4] + m[2]*inv[8] + m[3]*inv[12];
    if (dabs(det) < 1e-300) return 0;
    det = 1.0 / det;
    for (int i = 0; i < 16; i++) o->m[i] = inv[i] * det;
    return 1;
}

static void xform(const M4 *a, const double p[4], double o[4])
{
    for (int c = 0; c < 4; c++)
        o[c] = p[0] * a->m[c] + p[1] * a->m[4 + c] + p[2] * a->m[8 + c]
             + p[3] * a->m[12 + c];
}

/* What lmain_vv's wsSphere() recovers from the same matrix. */
typedef struct {
    double cx, cy, cz, sx, sy, r2w, r3w;
    int ok;
} Frame;

static void frame_of(const M4 *a, Frame *f)
{
    const double *m = a->m;
    double r0[4] = { m[0], m[4], m[8], m[12] };
    double r1[4] = { m[1], m[5], m[9], m[13] };
    double r2[4] = { m[2], m[6], m[10], m[14] };
    double r3[4] = { m[3], m[7], m[11], m[15] };
    double n3 = r3[0] * r3[0] + r3[1] * r3[1] + r3[2] * r3[2];
    f->ok = 0;
    if (n3 < 1e-20) return;
    double s = dsqrt(n3);
    f->cx = (r0[0] * r3[0] + r0[1] * r3[1] + r0[2] * r3[2]) / n3;
    f->cy = (r1[0] * r3[0] + r1[1] * r3[1] + r1[2] * r3[2]) / n3;
    f->cz = (r2[0] * r3[0] + r2[1] * r3[1] + r2[2] * r3[2]) / n3;
    double tx[3], ty[3];
    for (int i = 0; i < 3; i++) {
        tx[i] = r0[i] - f->cx * r3[i];
        ty[i] = r1[i] - f->cy * r3[i];
    }
    f->sx = dsqrt(tx[0] * tx[0] + tx[1] * tx[1] + tx[2] * tx[2]) / s;
    f->sy = dsqrt(ty[0] * ty[0] + ty[1] * ty[1] + ty[2] * ty[2]) / s;
    f->r2w = r2[3];
    f->r3w = r3[3];
    if (f->sx < 1e-20 || f->sy < 1e-20) return;
    f->ok = 1;
}

/* FFNx ApplySphericalWorld on a clip vector, exactly as lmain_vv does it
   (without the shader's depth squeeze: the result is mapped back to model
   space, and the squeeze is applied at projection time instead). */
static void sphere(const Frame *f, const double clip[4], double o[4])
{
    /* The terrain matrix ends in TL pixels: screen y grows DOWN, so down
       is +clip.y here (lmain_vv's NDC y grows up, hence its minus). */
    double X = (clip[0] - f->cx * clip[3]) / f->sx;
    double Y = (clip[1] - f->cy * clip[3]) / f->sy;
    double Z = clip[3];
    double d = dsqrt(X * X + Z * Z);
    double rp = -(double)SPHERE_R;
    double e = dexp(Y / rp);
    double sa, ca;
    dsincos(d / rp, &sa, &ca);
    double Y2 = rp * e * ca - rp;
    double d2 = rp * e * sa;
    double k = (d > 0.001) ? d2 / d : e;
    double X2 = X * k, Z2 = Z * k;
    o[0] = f->sx * X2 + f->cx * Z2;
    o[1] = f->cy * Z2 + f->sy * Y2;
    o[2] = f->cz * (Z2 - f->r3w) + f->r2w;
    o[3] = Z2;
}

/* ------------------------------------------------------------ bend */
__attribute__((section(".text.worldfar_bend")))
void worldfar_bend(State *st, g2h_fn g2h, callx_fn call)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    u32 n = st->nv_hint ? st->nv_hint : 122;
    st->nv_hint = 0;
    if (n > 122) n = 122;
    M4 m, inv;
    read_m4(v, G_COMBINED, &m);
    Frame f;
    frame_of(&m, &f);
    if (!f.ok || !invert(&m, &inv))
        return;
    for (u32 i = 0; i < n; i++) {
        u32 g = G_VERTS_F + 12 * i;
        double p[4] = { rdf(v, g), rdf(v, g + 4), rdf(v, g + 8), 1.0 };
        double c[4], o[4], q[4];
        xform(&m, p, c);
        if (c[3] <= 1.0)
            continue;               /* at or behind the eye: leave it */
        sphere(&f, c, o);
        xform(&inv, o, q);
        if (dabs(q[3]) < 1e-12)
            continue;
        wrf(v, g, (float)(q[0] / q[3]));
        wrf(v, g + 4, (float)(q[1] / q[3]));
        wrf(v, g + 8, (float)(q[2] / q[3]));
    }
}

/* ------------------------------------------------------------ camera */
typedef struct {
    float cx[3], cy[3], cz[3];       /* columns of R, unit scale */
    s32 t[3];
    float dy;                        /* -[DE6A04], the y of every tile pos */
    float horizon;                   /* draw radius about the focus */
} Cam;

static void apply(Env *v, u32 scratch, s16 x, s16 y, s16 z, s32 out[3])
{
    wr16(v, scratch, (u16)x); wr16(v, scratch + 2, (u16)y);
    wr16(v, scratch + 4, (u16)z); wr16(v, scratch + 6, 0);
    v->call(F_APPLY, 3, scratch, scratch + 0x10, scratch + 0x20);
    out[0] = (s32)rd32(v, scratch + 0x10);
    out[1] = (s32)rd32(v, scratch + 0x14);
    out[2] = (s32)rd32(v, scratch + 0x18);
}

static void camera(Env *v, u32 scratch, Cam *c)
{
    s32 o[3], a[3];
    v->call(F_RESET_GTE, 0);
    apply(v, scratch, 0, 0, 0, o);
    c->t[0] = o[0]; c->t[1] = o[1]; c->t[2] = o[2];
    apply(v, scratch, 4096, 0, 0, a);
    for (int i = 0; i < 3; i++) c->cx[i] = (float)(a[i] - o[i]) / 4096.0f;
    apply(v, scratch, 0, 4096, 0, a);
    for (int i = 0; i < 3; i++) c->cy[i] = (float)(a[i] - o[i]) / 4096.0f;
    apply(v, scratch, 0, 0, 4096, a);
    for (int i = 0; i < 3; i++) c->cz[i] = (float)(a[i] - o[i]) / 4096.0f;
    c->dy = -(float)(s32)rd32(v, G_CAM_DELTA_Y);
    float tx = (float)o[0], ty = (float)o[1], tz = (float)o[2];
    float camy = -(c->cy[0] * tx + c->cy[1] * ty + c->cy[2] * tz);
    float h = camy - c->dy;
    if (h < 0) h = -h;
    if (h < 500.0f) h = 500.0f;
    float d = fsqrt(2.0f * SPHERE_R * h) + fsqrt(2.0f * SPHERE_R * MOUNTAIN)
              + 16384.0f;
    if (d > 200000.0f) d = 200000.0f;
    c->horizon = d;
}

static void view(const Cam *c, float x, float y, float z, float out[3])
{
    for (int i = 0; i < 3; i++)
        out[i] = (float)c->t[i] + c->cx[i] * x + c->cy[i] * y + c->cz[i] * z;
}

/* ------------------------------------------------------------ drawing */
typedef struct {
    Env *v;
    Cam *c;
    u32 gte;
    u32 onset;
    int budget;
    int tiles;
    u32 scratch;
    float light[12];                 /* the world's 3x4 light matrix */
    float vx0, vy0, vx1, vy1;        /* viewport in TL pixels */
    u32 origin_tab;                  /* guest -> u16 u,v origin per tex */
    float uvscale;                   /* Cosmos Gaia's terrain UV factor */
} Ctx;

static int visible(Ctx *x, float px, float pz, float half, const Entry *e)
{
    float ymid = 0.5f * ((float)e->ymin + (float)e->ymax);
    float r = half * 1.4143f + 0.5f * (float)(e->ymax - e->ymin) + 64.0f;
    float w[3];
    view(x->c, px, x->c->dy + ymid, pz, w);
    if (w[2] + r < 0.0f)
        return 0;
    if (fabs_(w[0]) - r > 1.9f * (w[2] + r))
        return 0;
    return 1;
}

typedef struct { float x, y, z, rhw; u32 col; int ok; } TV;

/* 0x68DAE1 with the base colour 0x75F68C uses (255,255,255, alpha 0xFF):
   light the normal through the 3x4 matrix, clamp to 0..255, round to
   nearest (x87 fistp), R from .x into byte 2, .y byte 1, .z byte 0. */
static u8 chan(float l)
{
    if (l < 0.0f) return 0;
    float s = 255.0f * l;
    if (s >= 255.0f) return 255;
    float r = __builtin_rintf(s);
    return (u8)r;
}

static u32 light(const Ctx *x, float nx, float ny, float nz)
{
    const float *m = x->light;
    float lx = m[0] * nx + m[1] * ny + m[2] * nz + m[3];
    float ly = m[4] * nx + m[5] * ny + m[6] * nz + m[7];
    float lz = m[8] * nx + m[9] * ny + m[10] * nz + m[11];
    return (u32)chan(lz) | ((u32)chan(ly) << 8) | ((u32)chan(lx) << 16)
         | 0xFF000000u;
}

/* The depth squeeze lmain_vv applies to models, here for TL terrain:
   ndc = a + b / Z; past half the far plane Z is compressed smoothly into
   the rest of it (same value and slope at the knee, never reaching it). */
static float squeeze(float w, float a, float b)
{
    float den = 1.0f - a;
    if (den > -1e-12f && den < 1e-12f) return w;
    float zf = b / den;
    if (!(zf > 0.0f)) return w;
    float zc = 0.5f * zf, k = 0.999f * zf - zc;
    if (w <= zc) return w;
    return zc + k * (1.0f - (float)dexp(-(double)((w - zc) / k)));
}

static void emit(Ctx *x, const Entry *e, s32 px, s32 pz, u8 skirts)
{
    Env *v = x->v;
    State *st = v->st;
    int want = e->ntri;
    for (int k = 0; k < 4; k++)
        if (skirts & (1 << k)) want += e->sk_n[k];
    if (want > x->budget || e->nverts == 0)
        return;
    float w[3];
    view(x->c, (float)px, x->c->dy, (float)pz, w);
    s32 t[3] = { (s32)w[0], (s32)w[1], (s32)w[2] };
    for (int i = 0; i < 3; i++)
        wr32(v, x->gte + 0x22 + 4 * i, (u32)t[i]);
    st->nv_hint = e->nverts;
    v->call(F_TRANSFORM, 2, st->data + e->verts, x->onset);
    st->nv_hint = 0;

    /* project, light */
    M4 m;
    read_m4(v, G_COMBINED, &m);
    double a = 0, b = 0;
    {
        /* clip.z = a * clip.w + b for a perspective projection */
        double n3 = m.m[3] * m.m[3] + m.m[7] * m.m[7] + m.m[11] * m.m[11];
        if (n3 > 1e-20) {
            a = (m.m[2] * m.m[3] + m.m[6] * m.m[7] + m.m[10] * m.m[11]) / n3;
            b = m.m[14] - a * m.m[15];
        }
    }
    TV tv[120];
    u32 nv = e->nverts;
    for (u32 i = 0; i < nv; i++) {
        u32 g = G_VERTS_F + 12 * i;
        double p[4] = { rdf(v, g), rdf(v, g + 4), rdf(v, g + 8), 1.0 };
        double c[4];
        xform(&m, p, c);
        TV *o = &tv[i];
        o->ok = c[3] > 1.0;
        if (!o->ok) continue;
        float cw = (float)c[3];
        float rhw = 1.0f / cw;
        o->x = (float)c[0] * rhw;
        o->y = (float)c[1] * rhw;
        o->rhw = rhw;
        float zs = squeeze(cw, (float)a, (float)b);
        o->z = (float)a + (float)b / zs;
        u32 ng = st->data + e->norms + 8 * i;
        float nxv = (float)rds16(v, ng) * (1.0f / 4096.0f);
        float nyv = (float)rds16(v, ng + 2) * (1.0f / 4096.0f);
        float nzv = (float)rds16(v, ng + 4) * (1.0f / 4096.0f);
        o->col = light(x, nxv, nyv, nzv);
    }

    /* triangles: main, then the chosen skirts */
    int ranges[5][2], nr = 0;
    ranges[nr][0] = 0; ranges[nr][1] = e->ntri; nr++;
    for (int k = 0; k < 4; k++)
        if ((skirts & (1 << k)) && e->sk_n[k]) {
            ranges[nr][0] = e->sk_first[k];
            ranges[nr][1] = e->sk_n[k];
            nr++;
        }
    u32 tris = st->data + e->tris;
    for (int r = 0; r < nr; r++) {
        for (int ti = ranges[r][0]; ti < ranges[r][0] + ranges[r][1]; ti++) {
            u32 tg = tris + 12u * (u32)ti;
            u8 tb[12];
            for (int j = 0; j < 12; j++) tb[j] = rd8(v, tg + j);
            if (tb[0] >= nv || tb[1] >= nv || tb[2] >= nv) continue;
            const TV *p0 = &tv[tb[0]], *p1 = &tv[tb[1]], *p2 = &tv[tb[2]];
            if (!p0->ok || !p1->ok || !p2->ok) continue;
            /* 0x760CC4, and 0x75F68C keeps area >= 0 after fistp */
            float area = p0->x * p1->y + p1->x * p2->y + p2->x * p0->y
                       - p0->x * p2->y - p1->x * p0->y - p2->x * p1->y;
            if (__builtin_rintf(area) < 0.0f) continue;
            /* whole triangle off one side of the viewport */
            if ((p0->x < x->vx0 && p1->x < x->vx0 && p2->x < x->vx0)
                || (p0->x > x->vx1 && p1->x > x->vx1 && p2->x > x->vx1)
                || (p0->y < x->vy0 && p1->y < x->vy0 && p2->y < x->vy0)
                || (p0->y > x->vy1 && p1->y > x->vy1 && p2->y > x->vy1))
                continue;
            u32 tex = ((u32)tb[10] | ((u32)tb[11] << 8)) & 0x1FF;
            u32 obj = rd32(v, G_TEX_OBJS + 4 * tex);
            if (!obj) continue;
            if (!v->call(F_ALLOC_SHAPES, 2, 1, obj)) continue;
            u32 vp = rd32(v, obj + 0x70);
            if (!vp) continue;
            float su = rdf(v, obj + 0x24), sv = rdf(v, obj + 0x28);
            u32 og = x->origin_tab + 4 * tex;
            s32 ou = (s32)(rd32(v, og) & 0xFFFF);
            s32 ov = (s32)(rd32(v, og) >> 16);
            const TV *pp[3] = { p0, p1, p2 };
            for (int k = 0; k < 3; k++) {
                u32 q = vp + TL_STRIDE * (u32)k;
                wrf(v, q, pp[k]->x);
                wrf(v, q + 4, pp[k]->y);
                wrf(v, q + 8, pp[k]->z);
                wrf(v, q + 0xC, pp[k]->rhw);
                wr32(v, q + 0x10, pp[k]->col);
                wrf(v, q + 0x18, (float)((s32)tb[4 + 2 * k] - ou) * su * x->uvscale);
                wrf(v, q + 0x1C, (float)((s32)tb[5 + 2 * k] - ov) * sv * x->uvscale);
            }
            x->budget--;
            st->last_tris++;
        }
    }
    x->tiles++;
}

static int in_window(int dxm, int dzm)
{
    return dxm >= -2 && dxm <= 2 && dzm >= -2 && dzm <= 2;
}

__attribute__((section(".text.worldfar_draw")))
void worldfar_draw(State *st, g2h_fn g2h, callx_fn call, float uvscale)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    if (rd32(v, G_MAP_TYPE) != 0)
        return;
    u32 base = rd32(v, G_WORLD_BASE);
    if (!base)
        return;
    if (st->magic != 0x52414657u || st->base != base) {
        if (st->failed_base == base)
            return;
        st->magic = 0;
        if (!load(v, base)) {
            st->failed_base = base;
            return;
        }
        st->magic = 0x52414657u;
        st->base = base;
        st->failed_base = 0;
    }
    st->frames++;
    st->last_tris = 0;
    st->last_tiles = 0;
    if (!v->call(F_DRAW_ENABLED, 0))
        return;

    s32 fx = (s32)rd32(v, G_PLAYER_POS);
    s32 fz = (s32)rd32(v, G_PLAYER_POS + 8);
    fx = ((fx % WRAP_X) + WRAP_X) % WRAP_X;
    fz = ((fz % WRAP_Z) + WRAP_Z) % WRAP_Z;
    int cx = fx >> 13, cz = fz >> 13;
    s32 lx = fx & 0x1FFF, lz = fz & 0x1FFF;

    Cam cam;
    u32 scratch = base + FAR_OFF + FAR_SCRATCH;
    camera(v, scratch, &cam);
    Ctx x;
    x.v = v; x.c = &cam; x.tiles = 0; x.scratch = scratch;
    x.gte = rd32(v, G_GTE);
    x.onset = rd32(v, G_ONSET);
    x.budget = MAX_TRIS_FRAME;
    /* ff7nx_gaia multiplies the six terrain UV results of 0x75F68C by the
       archive's uniform upscale; this path writes them itself */
    x.uvscale = (uvscale >= 0.125f && uvscale <= 16.0f) ? uvscale : 1.0f;
    if (!x.gte)
        return;
    u32 lg = rd32(v, G_LIGHT);
    if (!lg)
        return;
    for (int i = 0; i < 12; i++) x.light[i] = rdf(v, lg + 0xF8 + 4 * i);
    x.origin_tab = rd32(v, G_TEX_ORIGIN);
    if (!x.origin_tab)
        return;
    x.vx0 = (float)(s32)rd32(v, G_VIEW_X);
    x.vy0 = (float)(s32)rd32(v, G_VIEW_Y);
    x.vx1 = x.vx0 + (float)(s32)rd32(v, G_VIEW_W);
    x.vy1 = x.vy0 + (float)(s32)rd32(v, G_VIEW_H);
    if (!(x.vx1 > x.vx0 && x.vy1 > x.vy0)) {
        x.vx0 = -1e9f; x.vy0 = -1e9f; x.vx1 = 1e9f; x.vy1 = 1e9f;
    } else {
        /* 16:9 and the curve: a generous margin, the GPU clips the rest */
        float mw = 0.5f * (x.vx1 - x.vx0), mh = 0.5f * (x.vy1 - x.vy0);
        x.vx0 -= mw; x.vx1 += mw; x.vy0 -= mh; x.vy1 += mh;
    }

    for (int sz = 0; sz < SZ; sz++)
        for (int sx = 0; sx < SX; sx++) {
            int near = 0;
            for (int k = 0; k < 16 && !near; k++) {
                int dxm = wrapi(sx * 4 + (k & 3) - cx, MX);
                int dzm = wrapi(sz * 4 + (k >> 2) - cz, MZ);
                if (dxm >= -NEAR_RING && dxm <= NEAR_RING
                    && dzm >= -NEAR_RING && dzm <= NEAR_RING)
                    near = 1;
            }
            st->cls[sz * SX + sx] = near ? CLS_NEAR : CLS_L2;
        }

    for (int ring = 3; ring <= 8 && x.budget > 0; ring++)
        for (int dzm = -ring; dzm <= ring; dzm++)
            for (int dxm = -ring; dxm <= ring; dxm++) {
                if (dxm != -ring && dxm != ring && dzm != -ring && dzm != ring)
                    continue;
                int mx = ((cx + dxm) % MX + MX) % MX;
                int mz = ((cz + dzm) % MZ + MZ) % MZ;
                if (st->cls[(mz >> 2) * SX + (mx >> 2)] != CLS_NEAR)
                    continue;
                const Entry *e = &st->e[mz * MX + mx];
                s32 px = dxm * MESH - lx, pz = dzm * MESH - lz;
                float ax = (float)(px > 0 ? px : (px + MESH < 0 ? -(px + MESH) : 0));
                float az = (float)(pz > 0 ? pz : (pz + MESH < 0 ? -(pz + MESH) : 0));
                if (fsqrt(ax * ax + az * az) > cam.horizon)
                    continue;
                if (!visible(&x, (float)(px + MESH / 2), (float)(pz + MESH / 2),
                             MESH / 2, e))
                    continue;
                u8 sk = 0;
                if (in_window(dxm, dzm - 1)) sk |= 1;
                if (in_window(dxm + 1, dzm)) sk |= 2;
                if (in_window(dxm, dzm + 1)) sk |= 4;
                if (in_window(dxm - 1, dzm)) sk |= 8;
                emit(&x, e, px, pz, sk);
            }

    int order[N2], nord = 0;
    float dist[N2];
    s32 posx[N2], posz[N2];
    for (int s = 0; s < N2; s++) {
        if (st->cls[s] != CLS_L2) continue;
        int sx = s % SX, sz = s / SX;
        s32 rx = wrapi(sx * 4 * MESH + 2 * MESH - fx, WRAP_X);
        s32 rz = wrapi(sz * 4 * MESH + 2 * MESH - fz, WRAP_Z);
        float ax = (float)(rx < 0 ? -rx : rx) - 2.0f * MESH;
        float az = (float)(rz < 0 ? -rz : rz) - 2.0f * MESH;
        if (ax < 0) ax = 0;
        if (az < 0) az = 0;
        float dn = fsqrt(ax * ax + az * az);
        if (dn > cam.horizon) continue;
        if (!visible(&x, (float)rx, (float)rz, 2.0f * MESH, &st->e[N1 + s]))
            continue;
        int j = nord++;
        while (j > 0 && dist[order[j - 1]] > dn) {
            order[j] = order[j - 1];
            j--;
        }
        order[j] = s;
        dist[s] = dn; posx[s] = rx; posz[s] = rz;
    }
    for (int i = 0; i < nord && x.budget > 0; i++) {
        int s = order[i];
        int sx = s % SX, sz = s / SX;
        const Entry *e = &st->e[N1 + s];
        u8 sk = 0;
        int nb[4][2] = { { sx, sz - 1 }, { sx + 1, sz }, { sx, sz + 1 }, { sx - 1, sz } };
        for (int k = 0; k < 4; k++) {
            int nx = (nb[k][0] + SX) % SX, nz = (nb[k][1] + SZ) % SZ;
            int ns = nz * SX + nx;
            if (st->cls[ns] == CLS_NEAR
                || ((st->e[N1 + ns].flags ^ e->flags) & 1))
                sk |= (u8)(1 << k);
        }
        emit(&x, e, posx[s], posz[s], sk);
    }
    st->last_tiles = (u32)x.tiles;
    v->call(F_RESET_GTE, 0);
}

/* ------------------------------------------------------------ camera
 * FFNx's world camera (camera.cpp): pitch -95..-175 degrees and zoom up to
 * 35000. The right stick is unused on this port's world map (its
 * DirectInput emulation maps input ids 2..0x13 only, 0x10D3968), so:
 *   up/down     tilt: up looks toward the horizon, down at the ground
 *   left/right  zoom: right pulls the camera out, left brings it back
 *   R3          both back to the game's own camera
 * Runs right after the game's camera update 0x74E8CE, which rebuilds the
 * camera rotation (0xDFC448) and position (0xDE6A20, t = (0,0,dist)) every
 * frame from its own state, so these are pure offsets on top of it. The tilt
 * rotates the view about its own x axis with the translation unchanged: an
 * orbit about the player, as FFNx's is.
 */
__attribute__((section(".text.worldfar_camera")))
void worldfar_camera(State *st, g2h_fn g2h, callx_fn call, u8 **got)
{
    Env env = { g2h, call, st };
    Env *v = &env;
    if (rd32(v, G_MAP_TYPE) != 0 || !got)
        return;
    u8 *p = *got;
    if (!p) return;
    p = *(u8 **)(p + 0);
    if (!p) return;
    p = *(u8 **)(p + 8);
    if (!p) return;
    p = *(u8 **)(p + 0);
    if (!p) return;
    p = *(u8 **)(p + 0x88);
    if (!p) return;
    float ry = *(float *)(p + 0x40) - *(float *)(p + 0x44);
    float rx = *(float *)(p + 0x48) - *(float *)(p + 0x4C);
    unsigned long long buttons = *(unsigned long long *)(p + 0x20);
    float zoom = st->zoom, tilt = st->tilt;
    if (!(zoom >= 0.0f && zoom < 100000.0f)) zoom = 0.0f;
    if (!(tilt > -3.2f && tilt < 3.2f)) tilt = 0.0f;
    if (buttons & (1ull << 5)) {                 /* R3: StickR */
        zoom = 0.0f;
        tilt = 0.0f;
    }
    if (rx > STICK_DEADZONE)
        zoom += ZOOM_STEP * (rx - STICK_DEADZONE) / (1.0f - STICK_DEADZONE);
    else if (rx < -STICK_DEADZONE)
        zoom -= ZOOM_STEP * (-rx - STICK_DEADZONE) / (1.0f - STICK_DEADZONE);
    if (ry > STICK_DEADZONE)
        tilt -= TILT_STEP * (ry - STICK_DEADZONE) / (1.0f - STICK_DEADZONE);
    else if (ry < -STICK_DEADZONE)
        tilt += TILT_STEP * (-ry - STICK_DEADZONE) / (1.0f - STICK_DEADZONE);

    /* zoom: add to the distance the game just wrote */
    s32 base = (s32)rd32(v, G_CAM_TRANS_Z);
    float room = ZOOM_MAX_DIST - (float)base;
    if (room < 0.0f) room = 0.0f;
    if (zoom > room) zoom = room;
    if (zoom < 0.0f) zoom = 0.0f;
    if (zoom > 0.0f)
        wr32(v, G_CAM_TRANS_Z, (u32)(base + (s32)zoom));

    /* tilt: R' = Rx(delta) * R on the 3x3 the game just wrote. Row 2 is
       the view axis in world space; asin(|y|) is how far it looks below
       (or above) the horizontal, and the offset is added to that. */
    double R[3][3];
    for (int i = 0; i < 3; i++)
        for (int j = 0; j < 3; j++)
            R[i][j] = (double)rds16(v, G_CAM_ROT + 2 * (3 * i + j)) / 4096.0;
    double fy = dabs(R[2][1]);
    if (fy > 1.0) fy = 1.0;
    double mag0 = fy;                          /* asin by Newton */
    for (int it = 0; it < 30; it++) {
        double s, c;
        dsincos(mag0, &s, &c);
        if (c < 1e-6) break;
        mag0 -= (s - fy) / c;
    }
    double want = mag0 + (double)tilt;
    if (want < TILT_MIN) want = TILT_MIN;
    if (want > TILT_MAX) want = TILT_MAX;
    tilt = (float)(want - mag0);
    st->zoom = zoom;
    st->tilt = tilt;
    if (tilt == 0.0f)
        return;
    double sw, cw;
    dsincos(want, &sw, &cw);
    double best = 1e9, b1[3] = { 0 }, b2[3] = { 0 };
    for (int attempt = 0; attempt < 2; attempt++) {
        double d = attempt ? -(want - mag0) : (want - mag0);
        double s, c;
        dsincos(d, &s, &c);
        double r1[3], r2[3];
        for (int j = 0; j < 3; j++) {
            r1[j] = c * R[1][j] - s * R[2][j];
            r2[j] = s * R[1][j] + c * R[2][j];
        }
        double err = dabs(dabs(r2[1]) - sw);
        if (err < best) {
            best = err;
            for (int j = 0; j < 3; j++) { b1[j] = r1[j]; b2[j] = r2[j]; }
        }
    }
    for (int j = 0; j < 3; j++) {
        s32 a1 = (s32)(b1[j] * 4096.0 + (b1[j] >= 0 ? 0.5 : -0.5));
        s32 a2 = (s32)(b2[j] * 4096.0 + (b2[j] >= 0 ? 0.5 : -0.5));
        wr16(v, G_CAM_ROT + 2 * (3 + j), (u16)(s16)a1);
        wr16(v, G_CAM_ROT + 2 * (6 + j), (u16)(s16)a2);
    }
}
