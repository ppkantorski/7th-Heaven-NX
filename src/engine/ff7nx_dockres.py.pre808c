#!/usr/bin/env python3
"""
ff7nx_dockres.py -- BUILD 761: 1080p (or 900p) output when docked, 720p
handheld. Experimental, developer setting, off by default.

WHAT THE PORT DOES
==================
The game draws through EGL/GLES on an nn::vi layer it creates itself:

    +0x113BDBC  bl nn::vi::CreateLayer(Layer**, Display*)     default 1280x720
    +0x113BEE8  bl eglCreateWindowSurface                      on that layer
    +0x113BFF0  eglQuerySurface(EGL_WIDTH)  -> [0x3FEB730]     1280
    +0x113C010  eglQuerySurface(EGL_HEIGHT) -> [0x3FEB734]     720
                an FBO + renderbuffer of that size, blitted 1:1 to the window
                every frame (+0x113C758 glBlitFramebuffer)

and, separately, two hardcoded getters the renderer sizes itself from:

    +0x10FB090  mov w0, #1280 ; ret     screen width
    +0x10FB0A0  mov w0, #720  ; ret     screen height

`gfx_drv_init` (+0x10D5150) stores them, makes a logical width from the
height (4:3, or 16:9 with ff7nx_widescreen) and supersamples it by a
constant 1.5 (+0x10D528C fmov s0, #1.5) into the SCENE render target:
1440x1080 at 4:3, 1920x1080 at 16:9. The finished frame is drawn from that
target to the 1280x720 back buffer -- so at 720p the game already renders a
1080-line picture and throws a third of it away.

WHAT THIS DOES (three hooks, all exefs/main)
============================================
1. The layer. The `bl CreateLayer` becomes a call to a cave that asks
   nn::oe::GetOperationMode() (after nn::oe::Initialize(), which is
   idempotent: the SDK guards it with a flag). Handheld -> the original
   call, untouched. Docked -> the SDK's own
   nn::vi::CreateLayer(Layer**, Display*, int width, int height) overload,
   which the game does not import. Its address is read at run time from a
   GOT slot rtld fills when the module loads -- main's GLOB_DAT import of
   `longjmp`, which only the sdk module defines -- plus the two symbols'
   fixed distance in the title's own `sdk` (-0x10B2D4 on 1.0.3), taken from
   dump/exefs/sdk's symbol table at build time. Before branching, the cave
   compares the target's first two instruction words with that sdk; on any
   mismatch it takes the original call (720p) instead of jumping.
   (BUILD 761a anchored on GetOperationMode's PLT slot instead; on hardware
   that slot did not hold the function and the docked boot jumped into
   nothing -- see docs/build-notes/BUILD-761.md.)
   The EGL surface, its FBO and the 1:1 present blit all follow the layer
   size by themselves.
2. The getters return the real surface size ([0x3FEB730] / [0x3FEB734]),
   falling back to 1280 / 720 if asked before the surface exists.
3. The supersample factor becomes 1080 / height instead of 1.5 -- exactly 1.5
   at 720, 1.2 at 900, 1.0 at 1080 -- so the SCENE TARGET STAYS 1920x1080
   (or 1440x1080) IN EVERY MODE. Nothing is rendered at a higher internal
   resolution; at 1080p docked the finished frame is simply copied 1:1
   instead of being scaled down to 720p and back up by the TV.

The decision is made once, when the game starts. Undocking a game that
booted docked keeps the 1080p window (the console scales it to the panel);
docking a game that booted handheld keeps 720p until the next launch.

COST
====
The window's buffers and the present FBO grow from 1280x720 to 1920x1080
(or 1600x900), out of the same 256 MB graphics pool. The final full-screen
passes cover 2.25x the pixels at 1080p -- docked, where the GPU clock is
higher. The scene, the field buffer and every texture are unchanged.

SEVENTH_NX_DOCK_RES = '' / 'off' (stock, nothing written) | '900' | '1080'.

Licensed under GPLv3
Copyright (c) 2026 ppkantorski
"""

from __future__ import annotations

import nxpaths  # BUILD 755: project paths (src/nxpaths.py)
import os
import struct

import a64 as A
import ff7nx_cave

ENV = 'SEVENTH_NX_DOCK_RES'
MODES = {'900': (1600, 900), '1080': (1920, 1080), 'always': (1920, 1080)}
# BUILD 762: 'always' creates the 1920x1080 layer in every operation mode.
# Handheld, the compositor scales it to the 1280x720 panel for free, so
# docking or undocking at any time keeps a correct picture (and docking
# a game started handheld gives real 1080p). Hardware: same performance.
ALWAYS = ('always',)

# --- sites, each verified against its stock word before anything moves ----
LAYER_SITE = 0x113BDBC          # bl nn::vi::CreateLayer(Layer**, Display*)
GET_W = 0x10FB090               # mov w0, #0x500
GET_H = 0x10FB0A0               # mov w0, #0x2d0
FACTOR_SITE = 0x10D528C         # fmov s0, #1.5
STOCK = {GET_W: 0x5280A000, GET_H: 0x52805A00, FACTOR_SITE: 0x1E2F1000}

SURFACE_W = 0x3FEB730           # eglQuerySurface(EGL_WIDTH)  result
SURFACE_H = 0x3FEB734           # eglQuerySurface(EGL_HEIGHT) result
TARGET_LINES = 1080             # the scene target's height in every mode

SYM_CREATE2 = '_ZN2nn2vi11CreateLayerEPPNS0_5LayerEPNS0_7DisplayE'
SYM_CREATE_WH = '_ZN2nn2vi11CreateLayerEPPNS0_5LayerEPNS0_7DisplayEii'
SYM_OE_INIT = '_ZN2nn2oe10InitializeEv'
SYM_OE_MODE = '_ZN2nn2oe16GetOperationModeEv'
OPERATION_MODE_CONSOLE = 1      # nn::oe::OperationMode_Console

BR_X16 = 0xD61F0200


def mode(env=None):
    """(width, height) for the docked window, or None (stock)."""
    env = os.environ if env is None else env
    raw = str(env.get(ENV, '') or '').strip().lower().rstrip('p')
    return MODES.get(raw)


def always(env=None):
    """True when the layer is 1080p in every mode, not only docked."""
    env = os.environ if env is None else env
    return str(env.get(ENV, '') or '').strip().lower() in ALWAYS


def _word(img, va):
    return struct.unpack_from('<I', img, va)[0]


def _bl_target(va, w):
    if (w >> 26) not in (0x25, 0x05):
        return None
    imm = w & 0x3FFFFFF
    if imm & 0x2000000:
        imm -= 0x4000000
    return va + 4 * imm


def _plt_got(img, plt):
    """The GOT slot a PLT stub (adrp x16; ldr x17,[x16,#o]; add; br x17)
    jumps through."""
    w0, w1, w2, w3 = (_word(img, plt + 4 * k) for k in range(4))
    if (w0 & 0x9F00001F) != 0x90000010 or (w1 & 0xFFC003FF) != 0xF9400211 \
            or w3 != 0xD61F0220:
        raise ValueError('+0x%X is not a PLT stub' % plt)
    immlo, immhi = (w0 >> 29) & 3, (w0 >> 5) & 0x7FFFF
    imm = (immhi << 2) | immlo
    if imm & (1 << 20):
        imm -= 1 << 21
    page = (plt & ~0xFFF) + (imm << 12)
    return page + ((w1 >> 10) & 0xFFF) * 8


R_AARCH64_GLOB_DAT = 1025
# Anchor preference: GLOB_DAT imports of exefs/main that the sdk defines.
# GLOB_DAT slots are written by rtld when the module is loaded (unlike the
# PLT slots, which BUILD 761a anchored on and which did not hold the
# function's address on hardware -- the docked boot jumped into nothing).
ANCHORS = ('longjmp', '_ZNSt12length_errorD1Ev', 'stderr')


def _load_nso(path):
    import lz4.block
    d = open(path, 'rb').read()
    segs = [struct.unpack('<III', d[b:b + 12]) for b in (0x10, 0x20, 0x30)]
    comp = struct.unpack('<III', d[0x60:0x6C])
    flags = struct.unpack('<I', d[0xC:0x10])[0]
    img = bytearray(segs[2][1] + segs[2][2] + 0x1000)
    for i, (fo, mo, ds) in enumerate(segs):
        blob = d[fo:fo + comp[i]]
        raw = (lz4.block.decompress(blob, uncompressed_size=ds)
               if flags & (1 << i) else blob[:ds])
        img[mo:mo + len(raw)] = raw
    return bytes(img)


def _dyn(img):
    mod0 = struct.unpack_from('<I', img, 4)[0]
    dyn = mod0 + struct.unpack_from('<i', img, mod0 + 4)[0]
    tags, p = {}, dyn
    while True:
        tag, val = struct.unpack_from('<qQ', img, p)
        if tag == 0:
            break
        tags.setdefault(tag, val)
        p += 16
    return tags


def _symname(img, tags, i):
    name, _i, _o, shndx, value, _s = struct.unpack_from(
        '<IBBHQQ', img, tags[6] + 24 * i)
    e = img.index(b'\0', tags[5] + name)
    return bytes(img[tags[5] + name:e]).decode('latin1'), shndx, value


def defined_symbols(img):
    """{name: value} of the symbols a module defines."""
    tags, out, i = _dyn(img), {}, 0
    while tags[6] + 24 * i < tags[5]:
        nm, shndx, value = _symname(img, tags, i)
        if shndx:
            out[nm] = value
        i += 1
    return out


def glob_dat_slots(img):
    """{symbol: (GOT slot va, addend)} for exefs/main's GLOB_DAT relocs."""
    tags, out = _dyn(img), {}
    for o in range(tags[7], tags[7] + tags[8], 24):
        off, info, add = struct.unpack_from('<QQq', img, o)
        if info & 0xFFFFFFFF == R_AARCH64_GLOB_DAT and info >> 32:
            nm, shndx, _v = _symname(img, tags, info >> 32)
            if not shndx:
                out[nm] = (off, add)
    return out


def sdk_target(main_img, sdk_path, others=()):
    """(slot, delta, first8) -- CreateLayer(.., int, int) is
    [slot] + delta at run time; first8 = its first two instruction words,
    checked by the cave before it branches. `others` are the other
    modules' paths: an anchor any of them also defines is skipped."""
    sdk = _load_nso(sdk_path)
    S = defined_symbols(sdk)
    if SYM_CREATE_WH not in S:
        raise ValueError('the sdk module does not export %s' % SYM_CREATE_WH)
    clash = set()
    for o in others:
        clash |= set(defined_symbols(_load_nso(o)))
    slots = glob_dat_slots(main_img)
    for nm in ANCHORS:
        if nm in S and nm in slots and nm not in clash:
            slot, add = slots[nm]
            delta = S[SYM_CREATE_WH] - (S[nm] + add)
            if not -(1 << 32) < delta < (1 << 32):
                continue
            t = S[SYM_CREATE_WH]
            return slot, delta, struct.unpack_from('<Q', sdk, t)[0], nm
    raise ValueError('no load-time (GLOB_DAT) sdk anchor in exefs/main')


def imports(main_path):
    """{name: plt va} of exefs/main."""
    import sys
    tp = os.path.join(nxpaths.ROOT, 'tools', 'probes')
    if tp not in sys.path:
        sys.path.insert(0, tp)
    import nsosyms
    _m, plt = nsosyms.imports(main_path)
    return {name: va for va, name in plt.items()}


# ----------------------------------------------------------------- caves
def layer_cave(entry, addr, plt, slot, delta, first8, size, every=False):
    """Docked-only (every=False): stp/save x0,x1 -> oe::Initialize ->
    oe::GetOperationMode -> restore; handheld takes the original call.
    every=True (BUILD 762, 'always'): no mode query at all.
    Then x16 = [slot] +/- delta = CreateLayer(.., int, int); its first two
    instruction words are compared with the title's sdk before the branch,
    and any mismatch takes the original call (720p, no crash).
    x9/x16/x17 are free: caller-saved scratch at a call site."""
    w, h = size
    out, bne = [], None
    if not every:
        out += [A.stp64_pre(29, 30, 31, -0x20),
                A.add_imm64(29, 31, 0),              # mov x29, sp
                A.stp64_off(0, 1, 31, 0x10)]
        out.append(A.bl(addr(len(out)), plt[SYM_OE_INIT]))
        out.append(A.bl(addr(len(out)), plt[SYM_OE_MODE]))
        out += [A.cmp_imm(0, OPERATION_MODE_CONSOLE),
                A.ldp64_off(0, 1, 31, 0x10),
                A.ldp64_post(29, 30, 31, 0x20)]
        bne = len(out)
        out.append(None)                             # b.ne stock
    mag = abs(delta)
    out.append(A.adrp(16, addr(len(out)), slot))
    out.append(A.ldr64(16, 16, slot & 0xFFF))
    out += [A.movz(17, mag & 0xFFFF), A.movk_hi(17, (mag >> 16) & 0xFFFF),
            (A.add_reg64 if delta >= 0 else A.sub_reg64)(16, 16, 17),
            A.ldr64(17, 16, 0)]
    for k in range(4):                               # x9 = first8
        part = (first8 >> (16 * k)) & 0xFFFF
        out.append((0xD2800000 if k == 0 else 0xF2800000)
                   | (k << 21) | (part << 5) | 9)    # movz/movk x9
    out.append(A.cmp_reg64(17, 9))
    bne2 = len(out)
    out.append(None)                                 # b.ne stock
    out += [A.movz(2, w), A.movz(3, h), BR_X16]
    st = len(out)
    out.append(A.b(addr(st), plt[SYM_CREATE2]))
    for k in (bne, bne2):
        if k is not None:
            out[k] = A.bcond(addr(k), addr(st), 0x1)  # b.ne
    return out


def getter_cave(entry, addr, slot, stock):
    """w0 = [slot] or, before the surface exists, the stock constant.
    Only w0 is touched, as the original two-word getter."""
    out = [A.adrp(0, addr(0), slot), A.ldr(0, 0, slot & 0xFFF)]
    out.append(A.cbnz(0, addr(len(out)), addr(len(out) + 2)))
    out += [stock, A.ret()]
    return out


def factor_cave(entry, addr):
    """s0 = 1080.0 / (float)w0 -- w0 is the screen height gfx_drv_init just
    fetched. 1.5 exactly at 720, so a handheld boot is bit-identical."""
    return [A.ucvtf_s(1, 0), A.movz(16, TARGET_LINES), A.ucvtf_s(0, 16),
            A.fdiv_s(0, 0, 1), A.ret()]


def build_patches(img, plt, target, size, starts=None, log=lambda *_: None,
                  every=False):
    for va, want in STOCK.items():
        if _word(img, va) != want:
            raise ValueError('+0x%X is %08X, expected %08X'
                             % (va, _word(img, va), want))
    if _bl_target(LAYER_SITE, _word(img, LAYER_SITE)) != plt.get(SYM_CREATE2):
        raise ValueError('+0x%X is not `bl CreateLayer`' % LAYER_SITE)
    for s in (SYM_CREATE2, SYM_OE_INIT, SYM_OE_MODE):
        if s not in plt:
            raise ValueError('exefs/main does not import %s' % s)
    slot, delta, first8, anchor = target
    pool = ff7nx_cave.HolePool(bytearray(img), starts=starts)
    words = {}
    e, c = ff7nx_cave.emit_laid_out(
        pool, lambda en, ad: layer_cave(en, ad, plt, slot, delta, first8, size, every))
    words.update(c)
    words[LAYER_SITE] = A.bl(LAYER_SITE, e)
    log('  dock res: layer cave %d words at +0x%X (anchor %s, slot +0x%X, '
        '%+#x)' % (len(c), e, anchor, slot, delta))
    for site, slot in ((GET_W, SURFACE_W), (GET_H, SURFACE_H)):
        stock = _word(img, site)
        e, c = ff7nx_cave.emit_laid_out(
            pool, lambda en, ad, s=slot, k=stock: getter_cave(en, ad, s, k))
        words.update(c)
        words[site] = A.b(site, e)
    e, c = ff7nx_cave.emit_laid_out(pool, factor_cave)
    words.update(c)
    words[FACTOR_SITE] = A.bl(FACTOR_SITE, e)
    return words


def hx(word):
    return ' '.join('%02X' % b for b in struct.pack('<I', word))


def apply_to_nso(src, dest, sdk_path, size, log=lambda *_: None,
                 every=False):
    """Write `dest` from `src`. False when nothing was written."""
    from pathlib import Path as _P
    import nxmap
    import nso_patcher
    try:
        plt = imports(str(src))
        module = nxmap.Main(str(src))
        d = os.path.dirname(str(sdk_path))
        others = [os.path.join(d, f) for f in sorted(os.listdir(d))
                  if f.startswith('subsdk')]
        target = sdk_target(bytes(module.img), sdk_path, others)
        words = build_patches(module.img, plt, target, size,
                              set(module.arm_starts), log, every)
    except Exception as exc:                                  # noqa: BLE001
        log('! dock res: %s: %s -- nothing written, 720p as shipped'
            % (type(exc).__name__, exc))
        return False
    spec = {'name': 'dock res %dx%d' % size,
            'patches': [{'name': '+0x%X' % va, 'va': hex(va),
                         'expect': hx(_word(module.img, va)),
                         'set': hx(words[va])} for va in sorted(words)]}
    nso = nso_patcher.read_nso(_P(str(src)))
    nso_patcher.apply_spec(nso, spec)
    data = nso_patcher.rebuild(nso)
    with open(str(dest), 'wb') as f:
        f.write(data)
    if every:
        log('  dock res: %dx%d in every mode (handheld: the system scales '
            'it to the panel); scene target unchanged' % size)
    else:
        log('  dock res: %dx%d when docked (decided at launch), 1280x720 '
            'handheld; scene target unchanged (factor = 1080 / height)' % size)
    return True
